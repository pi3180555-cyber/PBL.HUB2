local CFG={Key="PBL2026",Nome=LP.Name,Versao="v3.0",Disc="https://discord.gg/x"}
local T={Bg=Color3.fromRGB(28,28,32),Bg2=Color3.fromRGB(38,38,42),Sb=Color3.fromRGB(22,22,26),SbA=Color3.fromRGB(45,45,50),
Cd=Color3.fromRGB(52,52,58),Cd2=Color3.fromRGB(38,38,43),CdH=Color3.fromRGB(62,62,70),Tx=Color3.fromRGB(245,245,248),
TxD=Color3.fromRGB(150,150,160),TxS=Color3.fromRGB(190,190,200),Gd=Color3.fromRGB(212,175,100),Sc=Color3.fromRGB(80,220,120),
Er=Color3.fromRGB(255,90,100),Ac=Color3.fromRGB(100,180,255),Wr=Color3.fromRGB(255,190,60)}
local function C(p,r) local c=Instance.new("UICorner")c.CornerRadius=UDim.new(0,r or 10)c.Parent=p return c end
local function S(p,c,t,tr) local s=Instance.new("UIStroke")s.Color=c s.Thickness=t or 1 s.Transparency=tr or 0 s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border s.Parent=p return s end
local function G(p,c1,c2,r) local g=Instance.new("UIGradient")g.Color=ColorSequence.new(c1,c2)g.Rotation=r or 90 g.Parent=p return g end
local function SD(id,v,pi) pcall(function() local s=Instance.new("Sound")s.SoundId=id s.Volume=v or 0.35 s.PlaybackSpeed=pi or 1 s.Parent=SS s:Play()game:GetService("Debris"):AddItem(s,3)end)end
local function hov() SD("rbxassetid://5810725781",0.22,1.15) end
local function clk() SD("rbxassetid://6895094670",0.35,1.1) end
local function err() SD("rbxassetid://9114419659",0.4,0.85) end
local function suc() SD("rbxassetid://9125402735",0.4,1) end
for _,n in ipairs({"PBL_Key","PBL_Main","PBL_Notif"}) do local o=CG:FindFirstChild(n)if o then o:Destroy()end end
local function notif(msg,cor) pcall(function()local o=CG:FindFirstChild("PBL_Notif")if o then o:Destroy()end
local g=Instance.new("ScreenGui")g.Name="PBL_Notif"g.Parent=CG g.IgnoreGuiInset=true g.DisplayOrder=9999
local f=Instance.new("Frame")f.Size=UDim2.new(0,320,0,50)f.Position=UDim2.new(0.5,-160,0,25)f.BackgroundColor3=T.Cd f.BorderSizePixel=0 f.Parent=g C(f,10)S(f,cor,1.5,0.3)
local b=Instance.new("Frame")b.Size=UDim2.new(0,3,1,0)b.BackgroundColor3=cor b.BorderSizePixel=0 b.Parent=f C(b,10)
local l=Instance.new("TextLabel")l.Size=UDim2.new(1,-25,1,0)l.Position=UDim2.new(0,18,0,0)l.BackgroundTransparency=1 l.Text=msg l.TextColor3=T.Tx l.TextSize=12 l.Font=Enum.Font.GothamMedium l.TextXAlignment=Enum.TextXAlignment.Left l.Parent=f
task.delay(3,function()if g then g:Destroy()end end)end)end
local FN={}
FN.chilli=function()pcall(function()loadstring(game:HttpGet("https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua"))()end)end
FN.miranda_afk=function()pcall(function()loadstring(game:HttpGet("https://raw.githubusercontent.com/miirandahub/loader/refs/heads/main/mirandaafk.lua"))()end)end
FN.miranda_steal=function()pcall(function()loadstring(game:HttpGet("https://raw.githubusercontent.com/miirandahub/loader/refs/heads/main/stealaeggs"))()end)end
FN.lennon_farm=function()pcall(function()loadstring(game:HttpGet("https://raw.githubusercontent.com/lennonxscripts/lennonfarm/refs/heads/main/farmv1.lua"))()end)end
FN.lennon_steal=function()pcall(function()loadstring(game:HttpGet("https://raw.githubusercontent.com/lennonxscripts/lennonhubv3/refs/heads/main/stealanegg.lua"))()end)end
FN.rejoin=function()notif("Reconectando...",T.Ac)task.wait(0.5)TP:Teleport(game.PlaceId,LP)end
FN.fullbright=function()pcall(function()LG.Ambient=Color3.fromRGB(255,255,255)LG.Brightness=2 end)notif("Fullbright ON",T.Sc)end
FN.reset=function()pcall(function()LP.Character.Humanoid.Health=0 end)notif("Resetado",T.Er)end
FN.speed=function()pcall(function()LP.Character.Humanoid.WalkSpeed=math.random(45,55)end)notif("Speed ON",T.Sc)end
FN.noclip=function()pcall(function()for _,p in ipairs(LP.Character:GetDescendants())do if p:IsA("BasePart")then p.CanCollide=false end end end)notif("Noclip ON",T.Wr)end
FN.fly=function()pcall(function()local h=LP.Character.HumanoidRootPart local b=Instance.new("BodyVelocity")b.MaxForce=Vector3.new(1e5,1e5,1e5)b.Velocity=Vector3.new(0,50,0)b.Parent=h task.delay(5,function()b:Destroy()end)end)notif("Voando 5s",T.Ac)end
FN.hide=function()for _,p in ipairs(PL:GetPlayers())do if p~=LP and p.Character then for _,o in ipairs(p.Character:GetDescendants())do if o:IsA("BasePart")then o.LocalTransparencyModifier=1 end end end end notif("Players escondidos",T.Ac)end
FN.antiafk=function()pcall(function()LP.Idled:Connect(function()task.wait(math.random(3,8))VU:CaptureController()VU:ClickButton2(Vector2.new())end)end)notif("Anti-AFK ON",T.Sc)end
FN.fps=function()pcall(function()for _,o in ipairs(workspace:GetDescendants())do if o:IsA("ParticleEmitter")or o:IsA("Trail")then o.Enabled=false end end end)notif("FPS Boost ON",T.Wr)end
FN.ping=function()local p=math.floor(ST.Network.ServerStatsItem["Data Ping"]:GetValue())notif("Ping: "..p.."ms",p<100 and T.Sc or T.Wr)end
FN.antivoid=function()notif("Anti-Void ON",T.Sc)task.spawn(function()while true do pcall(function()local c=LP.Character if not c then return end local h=c:FindFirstChild("HumanoidRootPart")if h and h.Position.Y<-50 then h.CFrame=CFrame.new(0,50,0)notif("Anti-Void salvou!",T.Wr)end end)task.wait(math.random(2,5))end end)end
FN.social=function()pcall(function()for _,p in ipairs(PL:GetPlayers())do if p~=LP then LP:RequestFriendship(p)end end end)notif("Amigos enviados",T.Ac)end
FN.clear=function()for _,n in ipairs({"PBL_Notif","PBL_Confirm"})do local o=CG:FindFirstChild(n)if o then o:Destroy()end end notif("Tudo fechado",T.Er)end
