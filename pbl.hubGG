local tabs={} local conts={}
local function Tab(nome,ic,id)
local b=Instance.new("TextButton")b.Size=UDim2.new(0,82,0,58)b.BackgroundColor3=T.Sb b.BackgroundTransparency=1 b.Text=""b.BorderSizePixel=0 b.AutoButtonColor=false b.Parent=Sb C(b,8)
local iL=Instance.new("TextLabel")iL.Size=UDim2.new(1,0,0,24)iL.Position=UDim2.new(0,0,0,8)iL.BackgroundTransparency=1 iL.Text=ic iL.TextSize=20 iL.Font=Enum.Font.GothamBold iL.TextColor3=T.TxD iL.Parent=b
local nL=Instance.new("TextLabel")nL.Size=UDim2.new(1,0,0,14)nL.Position=UDim2.new(0,0,0,36)nL.BackgroundTransparency=1 nL.Text=nome nL.TextSize=9 nL.Font=Enum.Font.GothamBold nL.TextColor3=T.TxD nL.Parent=b
b.MouseEnter:Connect(function()if tabs[id]then return end hov()TS:Create(b,TweenInfo.new(0.15),{BackgroundTransparency=0.7}):Play()end)
b.MouseLeave:Connect(function()if tabs[id]then return end TS:Create(b,TweenInfo.new(0.15),{BackgroundTransparency=1}):Play()end)
b.MouseButton1Click:Connect(function()clk()
for k,v in pairs(tabs)do local tb=v.btn local ti=v.ic local tn=v.nm tabs[k]=nil TS:Create(tb,TweenInfo.new(0.15),{BackgroundTransparency=1}):Play()TS:Create(ti,TweenInfo.new(0.15),{TextColor3=T.TxD}):Play()TS:Create(tn,TweenInfo.new(0.15),{TextColor3=T.TxD}):Play()end
tabs[id]={btn=b,ic=iL,nm=nL}
TS:Create(b,TweenInfo.new(0.15),{BackgroundTransparency=0}):Play()TS:Create(b,TweenInfo.new(0.15),{BackgroundColor3=T.SbA}):Play()
TS:Create(iL,TweenInfo.new(0.15),{TextColor3=T.Tx}):Play()TS:Create(nL,TweenInfo.new(0.15),{TextColor3=T.Tx}):Play()
for k,f in pairs(conts)do f.Visible=(k==id)end end)
end
