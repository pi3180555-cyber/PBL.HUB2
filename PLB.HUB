local function telaObrigado(callback)
    local g = Instance.new("ScreenGui")
    g.Name = "PBL_Obrigado"
    g.Parent = CoreGui
    g.IgnoreGuiInset = true
    g.DisplayOrder = 550
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = 0.35
    ov.BorderSizePixel = 0
    ov.Parent = g
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 0, 0, 0)
    f.Position = UDim2.new(0.5, 0, 0.5, 0)
    f.BackgroundColor3 = Theme.Bg
    f.BorderSizePixel = 0
    f.Parent = g
    corner(f, 16)
    grad(f, Theme.Bg, Theme.Card, 45)
    stroke(f, Theme.Success, 2, 0.2)
    TweenSvc:Create(f, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 440, 0, 220), Position = UDim2.new(0.5, -220, 0.5, -110)
    }):Play()
    task.wait(0.4)
    local checkBox = Instance.new("Frame")
    checkBox.Size = UDim2.new(0, 56, 0, 56)
    checkBox.Position = UDim2.new(0.5, -28, 0, 25)
    checkBox.BackgroundColor3 = Theme.Success
    checkBox.BackgroundTransparency = 0.85
    checkBox.BorderSizePixel = 0
    checkBox.Parent = f
    corner(checkBox, 28)
    local check = Instance.new("TextLabel")
    check.Size = UDim2.new(1, 0, 1, 0)
    check.BackgroundTransparency = 1
    check.Text = "OK"
    check.TextColor3 = Theme.Success
    check.TextSize = 22
    check.Font = Enum.Font.GothamBold
    check.Parent = checkBox
    local t1 = Instance.new("TextLabel")
    t1.Size = UDim2.new(1, -20, 0, 32)
    t1.Position = UDim2.new(0, 10, 0, 92)
    t1.BackgroundTransparency = 1
    t1.Text = "OBRIGADO PELA COMPRA"
    t1.TextColor3 = Theme.Text
    t1.TextSize = 20
    t1.Font = Enum.Font.GothamBlack
    t1.Parent = f
    local t2 = Instance.new("TextLabel")
    t2.Size = UDim2.new(1, -20, 0, 18)
    t2.Position = UDim2.new(0, 10, 0, 125)
    t2.BackgroundTransparency = 1
    t2.Text = "Aproveite o " .. CONFIG.Versao
    t2.TextColor3 = Theme.TextDim
    t2.TextSize = 12
    t2.Font = Enum.Font.Gotham
    t2.Parent = f
    local t3 = Instance.new("TextLabel")
    t3.Size = UDim2.new(1, -20, 0, 15)
    t3.Position = UDim2.new(0, 10, 0, 150)
    t3.BackgroundTransparency = 1
    t3.Text = "Suporte: " .. CONFIG.DiscordLink
    t3.TextColor3 = Theme.Accent3
    t3.TextSize = 10
    t3.Font = Enum.Font.Gotham
    t3.Parent = f
    sSucesso()
    shakeTela(12, 0.5)
    task.wait(3)
    TweenSvc:Create(f, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    TweenSvc:Create(ov, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    for _, c in ipairs(f:GetDescendants()) do
        if c:IsA("TextLabel") then TweenSvc:Create(c, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        elseif c:IsA("Frame") then TweenSvc:Create(c, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play() end
    end
    task.wait(0.5)
    g:Destroy()
    if callback then callback() end
end

