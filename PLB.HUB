local function abrirSalaVIP()
    CONFIG.SalaVIP = true
    local vipGui = Instance.new("ScreenGui")
    vipGui.Name = "PBL_VIP"
    vipGui.Parent = CoreGui
    vipGui.IgnoreGuiInset = true
    vipGui.DisplayOrder = 800
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
