    ov.Parent = cGui
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 560, 0, 380)
    f.Position = UDim2.new(0.5, -280, 0.5, -190)
    f.BackgroundColor3 = Theme.Bg
    f.BorderSizePixel = 0
    f.Parent = cGui
    corner(f, 16)
    grad(f, Theme.Bg, Theme.Card, 45)
    stroke(f, Theme.Accent1, 1.5, 0.2)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -20, 0, 28)
    t.Position = UDim2.new(0, 10, 0, 15)
    t.BackgroundTransparency = 1
    t.Text = "CONQUISTAS - Nivel " .. Nivel
    t.TextColor3 = Theme.Text
    t.TextSize = 15
    t.Font = Enum.Font.GothamBlack
    t.Parent = f
    local cont = Instance.new("ScrollingFrame")
    cont.Size = UDim2.new(1, -30, 1, -80)
    cont.Position = UDim2.new(0, 15, 0, 55)
    cont.BackgroundTransparency = 1
    cont.BorderSizePixel = 0
    cont.ScrollBarThickness = 3
    cont.ScrollBarImageColor3 = Theme.Accent1
    cont.CanvasSize = UDim2.new(0, 0, 0, 0)
    cont.Parent = f
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, 6)
    l.Parent = cont
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        cont.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 10)
    end)
    local function contaFav()
        local c = 0
        for _ in pairs(favoritos) do c = c + 1 end
        return c
    end
    local lista = {
        {nome = "Primeiro Script", desc = "Execute 1 script", check = contadorScripts >= 1},
        {nome = "Viciado", desc = "Execute 10 scripts", check = contadorScripts >= 10},
        {nome = "Mestre", desc = "Execute 50 scripts", check = contadorScripts >= 50},
        {nome = "Colecionador", desc = "Favorite 5 scripts", check = contaFav() >= 5},
        {nome = "VIP", desc = "Entrou na Sala VIP", check = CONFIG.SalaVIP},
        {nome = "DJ", desc = "Trocou a musica", check = CONFIG.MusicaAtual > 1},
        {nome = "Iniciante", desc = "Alcancou nivel 2", check = Nivel >= 2},
        {nome = "Intermediario", desc = "Alcancou nivel 5", check = Nivel >= 5},
        {nome = "Lendario", desc = "Alcancou nivel 10", check = Nivel >= 10}
    }
    for _, c in ipairs(lista) do
        local item = Instance.new("Frame")
        item.Size = UDim2.new(1, 0, 0, 46)
        item.BackgroundColor3 = c.check and Color3.fromRGB(25, 45, 32) or Theme.Card
        item.BorderSizePixel = 0
        item.Parent = cont
        corner(item, 8)
        stroke(item, c.check and Theme.Success or Theme.TextDim, 1, 0.5)
        local barra = Instance.new("Frame")
        barra.Size = UDim2.new(0, 3, 1, 0)
        barra.BackgroundColor3 = c.check and Theme.Success or Theme.TextDim
        barra.BorderSizePixel = 0
        barra.Parent = item
        corner(barra, 8)
        local nl = Instance.new("TextLabel")
        nl.Size = UDim2.new(1, -80, 0, 16)
        nl.Position = UDim2.new(0, 15, 0, 8)
        nl.BackgroundTransparency = 1
        nl.Text = c.nome
        nl.TextColor3 = c.check and Theme.Success or Theme.TextSoft
        nl.TextSize = 12
        nl.Font = Enum.Font.GothamBold
        nl.TextXAlignment = Enum.TextXAlignment.Left
        nl.Parent = item
        local dl = Instance.new("TextLabel")
        dl.Size = UDim2.new(1, -80, 0, 13)
        dl.Position = UDim2.new(0, 15, 0, 24)
        dl.BackgroundTransparency = 1
        dl.Text = c.desc
        dl.TextColor3 = Theme.TextDim
        dl.TextSize = 10
        dl.Font = Enum.Font.Gotham
        dl.TextXAlignment = Enum.TextXAlignment.Left
        dl.Parent = item
        local chk = Instance.new("TextLabel")
        chk.Size = UDim2.new(0, 25, 1, 0)
        chk.Position = UDim2.new(1, -30, 0, 0)
        chk.BackgroundTransparency = 1
        chk.Text = c.check and "OK" or "--"
        chk.TextColor3 = c.check and Theme.Success or Theme.TextDim
        chk.TextSize = 12
        chk.Font = Enum.Font.GothamBold
        chk.Parent = item
    end
    local fechar = Instance.new("TextButton")
    fechar.Size = UDim2.new(1, -30, 0, 34)
    fechar.Position = UDim2.new(0, 15, 1, -45)
    fechar.BackgroundColor3 = Theme.Error
    fechar.Text = "FECHAR"
    fechar.TextColor3 = Theme.Text
    fechar.TextSize = 11
    fechar.Font = Enum.Font.GothamBold
    fechar.BorderSizePixel = 0
    fechar.AutoButtonColor = false
    fechar.Parent = f
    corner(fechar, 8)
    fechar.MouseEnter:Connect(function() sHover() end)
    fechar.MouseButton1Click:Connect(function() sClick() cGui:Destroy() end)
end

-- ═══════════════════════════════════════════════════════════
-- PESQUISA
-- ═══════════════════════════════════════════════════════════
local function abrirPesquisa()
    local pGui = Instance.new("ScreenGui")
    pGui.Name = "PBL_Pesquisa"
    pGui.Parent = CoreGui
    pGui.IgnoreGuiInset = true
    pGui.DisplayOrder = 850
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = 0.55
    ov.BorderSizePixel = 0
    ov.Parent = pGui
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 460, 0, 280)
    f.Position = UDim2.new(0.5, -230, 0.5, -140)
    f.BackgroundColor3 = Theme.Bg
    f.BorderSizePixel = 0
    f.Parent = pGui
    corner(f, 16)
    grad(f, Theme.Bg, Theme.Card, 45)
    stroke(f, Theme.Accent1, 1.5, 0.2)
    local t1 = Instance.new("TextLabel")
    t1.Size = UDim2.new(1, -20, 0, 28)
    t1.Position = UDim2.new(0, 10, 0, 22)
    t1.BackgroundTransparency = 1
    t1.Text = "O QUE VOCE ESTA ACHANDO?"
    t1.TextColor3 = Theme.Text
    t1.TextSize = 15
    t1.Font = Enum.Font.GothamBlack
    t1.Parent = f
    local t2 = Instance.new("TextLabel")
    t2.Size = UDim2.new(1, -20, 0, 18)
    t2.Position = UDim2.new(0, 10, 0, 52)
    t2.BackgroundTransparency = 1
    t2.Text = "Sua opiniao e importante"
    t2.TextColor3 = Theme.TextDim
    t2.TextSize = 10
    t2.Font = Enum.Font.Gotham
    t2.Parent = f
    local estrelas = {}
    local notaAtual = 0
    for i = 1, 5 do
        local est = Instance.new("TextButton")
        est.Size = UDim2.new(0, 52, 0, 52)
        est.Position = UDim2.new(0.5, -140 + (i-1)*56, 0, 95)
        est.BackgroundColor3 = Theme.Card
        est.Text = "*"
        est.TextColor3 = Theme.TextDim
        est.TextSize = 26
        est.Font = Enum.Font.GothamBold
        est.BorderSizePixel = 0
        est.AutoButtonColor = false
        est.Parent = f
        corner(est, 10)
        stroke(est, Theme.TextDim, 1, 0.6)
        est.MouseEnter:Connect(function() sHover() end)
        est.MouseButton1Click:Connect(function()
            sClick()
            notaAtual = i
            for j, e in ipairs(estrelas) do
                if j <= i then
                    TweenSvc:Create(e, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent1, TextColor3 = Theme.Text}):Play()
                else
                    TweenSvc:Create(e, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Card, TextColor3 = Theme.TextDim}):Play()
                end
            end
        end)
        estrelas[i] = est
    end
    local enviar = Instance.new("TextButton")
    enviar.Size = UDim2.new(0, 200, 0, 40)
    enviar.Position = UDim2.new(0.5, -100, 1, -100)
    enviar.BackgroundColor3 = Theme.Accent1
    enviar.Text = "ENVIAR"
    enviar.TextColor3 = Theme.Text
    enviar.TextSize = 11
    enviar.Font = Enum.Font.GothamBold
    enviar.BorderSizePixel = 0
    enviar.AutoButtonColor = false
    enviar.Parent = f
    corner(enviar, 8)
    grad(enviar, Theme.Accent1, Theme.Accent2, 0)
    local pular = Instance.new("TextButton")
    pular.Size = UDim2.new(0, 200, 0, 30)
    pular.Position = UDim2.new(0.5, -100, 1, -52)
    pular.BackgroundColor3 = Theme.BgSoft
    pular.Text = "Pular"
    pular.TextColor3 = Theme.TextDim
    pular.TextSize = 10
    pular.Font = Enum.Font.Gotham
    pular.BorderSizePixel = 0
    pular.AutoButtonColor = false
    pular.Parent = f
    corner(pular, 8)
    enviar.MouseEnter:Connect(function() sHover() end)
    pular.MouseEnter:Connect(function() sHover() end)
    enviar.MouseButton1Click:Connect(function()
        if notaAtual == 0 then
            sErro()
            notificar("Escolha uma nota", Theme.Warning)
            return
        end
        sSucesso()
        notificar("Obrigado! Voce deu " .. notaAtual .. " estrelas", Theme.Success)
        ganharXP(25)
        pGui:Destroy()
    end)
    pular.MouseButton1Click:Connect(function()
        sClick()
        pGui:Destroy()
    end)
end

