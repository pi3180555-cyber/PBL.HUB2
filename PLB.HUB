    ov.BackgroundTransparency = 0.55
    ov.BorderSizePixel = 0
    ov.Parent = vipGui
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 600, 0, 340)
    f.Position = UDim2.new(0.5, -300, 0.5, -170)
