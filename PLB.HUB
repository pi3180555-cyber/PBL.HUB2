    fechar.Parent = f
    corner(fechar, 8)
    fechar.MouseEnter:Connect(function() sHover() end)
    fechar.MouseButton1Click:Connect(function() sClick() pGui:Destroy() end)
end-- ═══════════════════════════════════════════════════════════
