    TweenSvc:Create(f, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 460, 0, 260), Position = UDim2.new(0.5, -230, 0.5, -130)
    }):Play()
    task.wait(0.5)
    local avatar = Instance.new("ImageLabel")
