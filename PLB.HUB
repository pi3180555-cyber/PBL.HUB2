    tituloVIP.BackgroundTransparency = 1
    tituloVIP.Text = "SALA VIP"
    tituloVIP.TextColor3 = Theme.Gold
    tituloVIP.TextSize = 18
    tituloVIP.Font = Enum.Font.GothamBlack
    tituloVIP.TextXAlignment = Enum.TextXAlignment.Left
    tituloVIP.Parent = h
    local subtituloVIP = Instance.new("TextLabel")
    subtituloVIP.Size = UDim2.new(1, -100, 0, 16)
    subtituloVIP.Position = UDim2.new(0, 25, 0, 40)
    subtituloVIP.BackgroundTransparency = 1
    subtituloVIP.Text = "Area premium - " .. CONFIG.Nome
    subtituloVIP.TextColor3 = Theme.TextDim
    subtituloVIP.TextSize = 10
    subtituloVIP.Font = Enum.Font.Gotham
    subtituloVIP.TextXAlignment = Enum.TextXAlignment.Left
    subtituloVIP.Parent = h
    local closeVIP = Instance.new("TextButton")
    closeVIP.Size = UDim2.new(0, 24, 0, 24)
    closeVIP.Position = UDim2.new(1, -34, 0, 23)
    closeVIP.BackgroundColor3 = Theme.Error
    closeVIP.Text = "X"
    closeVIP.TextColor3 = Theme.Text
    closeVIP.TextSize = 12
    closeVIP.Font = Enum.Font.GothamBold
    closeVIP.BorderSizePixel = 0
    closeVIP.AutoButtonColor = false
    closeVIP.Parent = h
    corner(closeVIP, 6)
    local aviso = Instance.new("TextLabel")
    aviso.Size = UDim2.new(1, -30, 1, -90)
    aviso.Position = UDim2.new(0, 15, 0, 82)
    aviso.BackgroundTransparency = 1
    aviso.Text = "Aguardando conteudo VIP..."
    aviso.TextColor3 = Theme.TextDim
    aviso.TextSize = 12
    aviso.Font = Enum.Font.Gotham
    aviso.Parent = f
    closeVIP.MouseEnter:Connect(function() sHover() end)
    closeVIP.MouseButton1Click:Connect(function()
        sClick()
        CONFIG.SalaVIP = false
        vipGui:Destroy()
    end)
    sSucesso()
    shakeTela(12, 0.4)
end

-- ═══════════════════════════════════════════════════════════
-- ESCOLHER MUSICA
-- ═══════════════════════════════════════════════════════════
local function escolherMusica()
    local mGui = Instance.new("ScreenGui")
    mGui.Name = "PBL_EscolherMusica"
    mGui.Parent = CoreGui
    mGui.IgnoreGuiInset = true
    mGui.DisplayOrder = 820
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = 0.55
    ov.BorderSizePixel = 0
    ov.Parent = mGui
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 560, 0, 340)
    f.Position = UDim2.new(0.5, -280, 0.5, -170)
    f.BackgroundColor3 = Theme.Bg
    f.BorderSizePixel = 0
    f.Parent = mGui
    corner(f, 16)
    grad(f, Theme.Bg, Theme.Card, 45)
    stroke(f, Theme.Accent1, 1.5, 0.2)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -20, 0, 28)
    t.Position = UDim2.new(0, 10, 0, 15)
    t.BackgroundTransparency = 1
    t.Text = "ESCOLHER MUSICA"
    t.TextColor3 = Theme.Text
    t.TextSize = 15
    t.Font = Enum.Font.GothamBlack
    t.Parent = f
    local grid = Instance.new("Frame")
    grid.Size = UDim2.new(1, -30, 1, -110)
    grid.Position = UDim2.new(0, 15, 0, 65)
    grid.BackgroundTransparency = 1
    grid.Parent = f
    local gridLayout = Instance.new("UIGridLayout")
    gridLayout.CellSize = UDim2.new(0, 122, 0, 55)
    gridLayout.CellPadding = UDim2.new(0, 6, 0, 6)
    gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
    gridLayout.Parent = grid
    for i, m in ipairs(Musicas) do
        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = (CONFIG.MusicaAtual == i) and Theme.Accent1 or Theme.Card
        btn.Text = ""
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.LayoutOrder = i
        btn.Parent = grid
        corner(btn, 8)
        stroke(btn, Theme.Accent1, 1, 0.6)
        local nl = Instance.new("TextLabel")
        nl.Size = UDim2.new(1, -10, 1, 0)
        nl.Position = UDim2.new(0, 5, 0, 0)
        nl.BackgroundTransparency = 1
        nl.Text = m.nome
        nl.TextColor3 = Theme.Text
        nl.TextSize = 11
        nl.Font = Enum.Font.GothamSemibold
        nl.Parent = btn
        btn.MouseEnter:Connect(function() sHover() end)
        btn.MouseButton1Click:Connect(function()
            sClick()
            tocarMusicaIndice(i)
            notificar(m.nome .. " tocando", Theme.Success)
            mGui:Destroy()
        end)
    end
    local fechar = Instance.new("TextButton")
    fechar.Size = UDim2.new(1, -30, 0, 34)
    fechar.Position = UDim2.new(0, 15, 1, -45)
    fechar.BackgroundColor3 = Theme.Error
    fechar.Text = "FECHAR"
    fechar.TextColor3 = Theme.Text
    fechar.TextSize = 11
    fechar.Font = Enum.Font.GothamBold
    fechar.BorderSizePixel = 0
    fechar.AutoButtonColor = false
    fechar.Parent = f
    corner(fechar, 8)
    fechar.MouseEnter:Connect(function() sHover() end)
    fechar.MouseButton1Click:Connect(function() sClick() mGui:Destroy() end)
end

-- ═══════════════════════════════════════════════════════════
-- FUNCOES UTILITARIAS
-- ═══════════════════════════════════════════════════════════
local funcoesUtil = {
    rejoin = function()
        notificar("Reconectando...", Theme.Accent3)
        task.wait(0.5)
        Teleport:Teleport(game.PlaceId, LP)
    end,
    hop = function()
        notificar("Procurando servidor...", Theme.Accent1)
        pcall(function()
            local servers = HttpSvc:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
            for _, srv in ipairs(servers.data) do
                if srv.id ~= game.JobId and srv.playing < srv.maxPlayers then
                    Teleport:TeleportToPlaceInstance(game.PlaceId, srv.id, LP)
                    return
                end
            end
            notificar("Nenhum servidor encontrado", Theme.Error)
        end)
    end,
    discord = function()
        notificar("Abrindo Discord...", Theme.Discord)
        pcall(function()
            game:GetService("GuiService"):OpenBrowserWindow(CONFIG.DiscordLink)
        end)
    end,
    musica = function()
        local t = toggleMusica()
        notificar(t and "Musica ligada" or "Musica pausada", t and Theme.Success or Theme.Warning)
    end,
    streamer = function()
        CONFIG.StreamerMode = not CONFIG.StreamerMode
        notificar(CONFIG.StreamerMode and "Streamer ON" or "Streamer OFF", Theme.Accent2)
    end,
    autoexec = function()
        CONFIG.AutoExecutar = not CONFIG.AutoExecutar
        notificar(CONFIG.AutoExecutar and "Auto-Exec ON" or "Auto-Exec OFF", CONFIG.AutoExecutar and Theme.Success or Theme.Warning)
    end,
    fechartudo = function()
        for _, n in ipairs({"PBL_Confirm","PBL_Notif","PBL_BemVindo","PBL_VIP","PBL_Pesquisa","PBL_EscolherMusica","PBL_Historico","PBL_Teleportes","PBL_MiniGame","PBL_Conquistas","PBL_PlayerList","PBL_Hotkeys","PBL_Perfil"}) do
            local o = CoreGui:FindFirstChild(n)
            if o then o:Destroy() end
        end
        notificar("Tudo fechado", Theme.Error)
    end,
    hide = function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LP and plr.Character then
                for _, p in ipairs(plr.Character:GetDescendants()) do
                    if p:IsA("BasePart") then p.LocalTransparencyModifier = 1 end
                end
            end
        end
        notificar("Jogadores escondidos", Theme.Accent2)
    end,
    social = function()
        pcall(function()
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LP then LP:RequestFriendship(plr) end
            end
        end)
        notificar("Pedidos enviados", Theme.Discord)
    end,
    antiafk = function()
        pcall(function()
            LP.Idled:Connect(function()
                task.wait(math.random(3, 8))
                VUser:CaptureController()
                task.wait(math.random(1, 3))
                VUser:ClickButton2(Vector2.new())
            end)
        end)
        notificar("Anti-AFK ativado", Theme.Success)
    end,
    fpsboost = function()
        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") then
                    obj.Enabled = false
                end
            end
        end)
        notificar("FPS Boost ativado", Theme.Warning)
    end,
    reset = function()
        pcall(function()
            local char = LP.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.Health = 0
            end
        end)
        notificar("Resetado", Theme.Error)
    end,
    fullbright = function()
        pcall(function()
            Lighting.Ambient = Color3.fromRGB(255,255,255)
            Lighting.Brightness = 2
            Lighting.OutdoorAmbient = Color3.fromRGB(255,255,255)
        end)
        notificar("Fullbright ativado", Theme.Warning)
    end,
    screenshot = function()
        notificar("Use PrintScreen ou F12", Theme.Accent3)
    end,
    userid = function()
        pcall(function()
            if setclipboard then setclipboard(tostring(LP.UserId))
            elseif toclipboard then toclipboard(tostring(LP.UserId)) end
        end)
        notificar("ID: " .. LP.UserId, Theme.Accent1)
    end,
    ping = function()
        local p = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        notificar("Ping: " .. p .. "ms", p < 100 and Theme.Success or Theme.Warning)
    end,
    speed = function()
        pcall(function()
            LP.Character.Humanoid.WalkSpeed = math.random(45, 55)
        end)
        notificar("Speed leve ativado", Theme.Success)
    end,
    fly = function()
        pcall(function()
            local hrp = LP.Character.HumanoidRootPart
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bv.Velocity = Vector3.new(0, 50, 0)
            bv.Parent = hrp
            task.delay(5, function() bv:Destroy() end)
        end)
        notificar("Voando 5s", Theme.Accent1)
    end,
    noclip = function()
        pcall(function()
            for _, p in ipairs(LP.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end)
        notificar("Noclip ativado", Theme.Warning)
    end,
    infinitejump = function()
        notificar("Infinite Jump indisponivel", Theme.Warning)
    end,
    antifling = function()
        notificar("Anti-Fling indisponivel", Theme.Warning)
    end,
    salavip = function() abrirSalaVIP() end,
    escolhermusica = function() escolherMusica() end,
    pesquisa = function() abrirPesquisa() end,
    historico = function() abrirHistorico() end,
    teleportes = function() abrirTeleportes() end,
    minigame = function() abrirMiniGame() end,
    conquistas = function() abrirConquistas() end,
    listajogadores = function() abrirListaJogadores() end,
    antivoid = function() toggleAntiVoid() end,
    hotkeys = function() abrirHotkeys() end,
    perfil = function() abrirPerfil() end,
    comprar = function()
        notificar("Discord: " .. CONFIG.DiscordLink, Theme.Success)
        pcall(function()
            game:GetService("GuiService"):OpenBrowserWindow(CONFIG.DiscordLink)
        end)
    end,
    sobre = function()
        notificar("PBL HUB " .. CONFIG.Versao, Theme.Accent3)
    end
}

