    local cardsGlobais = {}
    local function criarCard(parent, nome, desc, cor, url, ordem, tipo)
        tipo = tipo or "script"
        local Card = Instance.new("TextButton")
        Card.Size = UDim2.new(1, 0, 0, 64)
        Card.BackgroundColor3 = Theme.Card
        Card.Text = ""
        Card.BorderSizePixel = 0
        Card.AutoButtonColor = false
        Card.LayoutOrder = ordem
        Card.Parent = parent
        corner(Card, 10)
        grad(Card, Theme.Card, Theme.BgSoft, 90)
        local cs = stroke(Card, Theme.CardHover, 1, 0.7)
        local barra = Instance.new("Frame")
        barra.Size = UDim2.new(0, 4, 0.8, 0)
        barra.Position = UDim2.new(0, 0, 0.1, 0)
        barra.BackgroundColor3 = cor
        barra.BorderSizePixel = 0
        barra.Parent = Card
        corner(barra, 3)
        local nl = Instance.new("TextLabel")
        nl.Size = UDim2.new(1, -110, 0, 18)
        nl.Position = UDim2.new(0, 18, 0, 14)
        nl.BackgroundTransparency = 1
        nl.Text = CONFIG.StreamerMode and "Script Oculto" or nome
        nl.TextColor3 = Theme.Text
        nl.TextSize = 13
        nl.Font = Enum.Font.GothamBold
        nl.TextXAlignment = Enum.TextXAlignment.Left
        nl.Parent = Card
        local dl = Instance.new("TextLabel")
        dl.Size = UDim2.new(1, -110, 0, 14)
        dl.Position = UDim2.new(0, 18, 0, 34)
        dl.BackgroundTransparency = 1
        dl.Text = desc
        dl.TextColor3 = Theme.TextDim
        dl.TextSize = 10
        dl.Font = Enum.Font.Gotham
        dl.TextXAlignment = Enum.TextXAlignment.Left
        dl.Parent = Card
        if tipo == "script" then
            local fav = Instance.new("TextButton")
            fav.Size = UDim2.new(0, 22, 0, 22)
            fav.Position = UDim2.new(1, -54, 0.5, -11)
            fav.BackgroundColor3 = Theme.BgSoft
            fav.Text = favoritos[nome] and "*" or "-"
            fav.TextColor3 = favoritos[nome] and Theme.Warning or Theme.TextDim
            fav.TextSize = 14
            fav.Font = Enum.Font.GothamBold
            fav.BorderSizePixel = 0
            fav.AutoButtonColor = false
            fav.Parent = Card
            corner(fav, 6)
            fav.MouseEnter:Connect(function() sHover() end)
            fav.MouseButton1Click:Connect(function()
                sClick()
                favoritos[nome] = not favoritos[nome]
                fav.Text = favoritos[nome] and "*" or "-"
                fav.TextColor3 = favoritos[nome] and Theme.Warning or Theme.TextDim
            end)
        end
        local ar = Instance.new("TextLabel")
        ar.Size = UDim2.new(0, 20, 1, 0)
        ar.Position = UDim2.new(1, -24, 0, 0)
        ar.BackgroundTransparency = 1
        ar.Text = ">"
        ar.TextColor3 = cor
        ar.TextSize = 18
        ar.Font = Enum.Font.GothamBold
        ar.Parent = Card
        Card.MouseEnter:Connect(function()
            sHover()
            TweenSvc:Create(Card, TweenInfo.new(0.2), {BackgroundColor3 = Theme.CardHover}):Play()
            TweenSvc:Create(cs, TweenInfo.new(0.2), {Transparency = 0.1, Color = cor, Thickness = 1.5}):Play()
        end)
        Card.MouseLeave:Connect(function()
            TweenSvc:Create(Card, TweenInfo.new(0.25), {BackgroundColor3 = Theme.Card}):Play()
            TweenSvc:Create(cs, TweenInfo.new(0.25), {Transparency = 0.7, Color = Theme.CardHover, Thickness = 1}):Play()
        end)
        Card.MouseButton1Click:Connect(function()
            sClick()
            if tipo == "tema" then
                aplicarTema(url)
                notificar("Tema " .. url, cor)
                painelGui:Destroy()
                task.wait(0.2)
                criarPainel()
                return
            end
            if funcoesUtil[tipo] then
                funcoesUtil[tipo]()
                return
            end
            local confGui = Instance.new("ScreenGui")
            confGui.Name = "PBL_Confirm"
            confGui.Parent = CoreGui
            confGui.IgnoreGuiInset = true
            confGui.DisplayOrder = 600
            local cov = Instance.new("Frame")
            cov.Size = UDim2.new(1, 0, 1, 0)
            cov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            cov.BackgroundTransparency = 0.55
            cov.BorderSizePixel = 0
            cov.Parent = confGui
            local box = Instance.new("Frame")
            box.Size = UDim2.new(0, 340, 0, 180)
            box.Position = UDim2.new(0.5, -170, 0.5, -90)
            box.BackgroundColor3 = Theme.Bg
            box.BorderSizePixel = 0
            box.Parent = confGui
            corner(box, 16)
            grad(box, Theme.Bg, Theme.Card, 45)
            stroke(box, cor, 1.5, 0.3)
            local t1 = Instance.new("TextLabel")
            t1.Size = UDim2.new(1, -20, 0, 24)
            t1.Position = UDim2.new(0, 10, 0, 45)
            t1.BackgroundTransparency = 1
            t1.Text = "Deseja executar?"
            t1.TextColor3 = Theme.Text
            t1.TextSize = 16
            t1.Font = Enum.Font.GothamBlack
            t1.Parent = box
            local t2 = Instance.new("TextLabel")
            t2.Size = UDim2.new(1, -20, 0, 18)
            t2.Position = UDim2.new(0, 10, 0, 72)
            t2.BackgroundTransparency = 1
            t2.Text = nome
            t2.TextColor3 = cor
            t2.TextSize = 12
            t2.Font = Enum.Font.GothamSemibold
            t2.Parent = box
            local yes = Instance.new("TextButton")
            yes.Size = UDim2.new(0, 140, 0, 38)
            yes.Position = UDim2.new(0, 20, 1, -52)
            yes.BackgroundColor3 = Theme.Success
            yes.Text = "SIM"
            yes.TextColor3 = Color3.fromRGB(10, 10, 15)
            yes.TextSize = 12
            yes.Font = Enum.Font.GothamBold
            yes.BorderSizePixel = 0
            yes.AutoButtonColor = false
            yes.Parent = box
            corner(yes, 8)
            yes.MouseEnter:Connect(function() sHover() end)
            local no = Instance.new("TextButton")
            no.Size = UDim2.new(0, 140, 0, 38)
            no.Position = UDim2.new(1, -160, 1, -52)
            no.BackgroundColor3 = Theme.Error
            no.Text = "NAO"
            no.TextColor3 = Theme.Text
            no.TextSize = 12
            no.Font = Enum.Font.GothamBold
            no.BorderSizePixel = 0
            no.AutoButtonColor = false
            no.Parent = box
            corner(no, 8)
            no.MouseEnter:Connect(function() sHover() end)
            no.MouseButton1Click:Connect(function()
                sClick()
                confGui:Destroy()
            end)
            yes.MouseButton1Click:Connect(function()
                sClick()
                confGui:Destroy()
                task.wait(0.1)
                bemVindoPBL(nome, function()
                    if url and url ~= "" then
                        local ok, err = pcall(function()
                            loadstring(game:HttpGet(url))()
                        end)
                        if ok then
                            contadorScripts = contadorScripts + 1
                            table.insert(historico, nome .. " | " .. os.date("%H:%M:%S"))
                            notificar(nome .. " carregado", Theme.Success)
                            ganharXP(15)
                        else
                            notificar("Falha: " .. nome, Theme.Error)
                        end
                    end
                end)
            end)
        end)
        if tipo == "script" then
            cardsGlobais[nome] = {card = Card, nome = nome, desc = desc}
        end
    end
    local abas = {}
    local abasBtns = {}
    local function trocarAba(nomeAba)
        for n, f in pairs(abas) do
            f.Visible = (n == nomeAba)
        end
        for n, b in pairs(abasBtns) do
            if n == nomeAba then
                TweenSvc:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Accent1}):Play()
                b.TextColor3 = Theme.Text
            else
                TweenSvc:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Card}):Play()
                b.TextColor3 = Theme.TextDim
            end
        end
        pageTitle.Text = nomeAba
    end
    local function criarAba(nomeAba)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 30)
        btn.BackgroundColor3 = Theme.Card
        btn.Text = "  " .. nomeAba
        btn.TextColor3 = Theme.TextDim
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamSemibold
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = menuFrame
        corner(btn, 8)
        local frame = Instance.new("ScrollingFrame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 1
        frame.BorderSizePixel = 0
        frame.ScrollBarThickness = 3
        frame.ScrollBarImageColor3 = Theme.Accent1
        frame.CanvasSize = UDim2.new(0, 0, 0, 0)
        frame.Visible = false
        frame.Parent = content
        local l = Instance.new("UIListLayout")
        l.Padding = UDim.new(0, 7)
        l.SortOrder = Enum.SortOrder.LayoutOrder
        l.Parent = frame
        local p = Instance.new("UIPadding")
        p.PaddingTop = UDim.new(0, 3)
        p.PaddingBottom = UDim.new(0, 3)
        p.PaddingRight = UDim.new(0, 6)
        p.Parent = frame
        l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            frame.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 10)
        end)
        btn.MouseEnter:Connect(function() sHover() end)
        btn.MouseButton1Click:Connect(function()
            sClick()
            trocarAba(nomeAba)
        end)
        abas[nomeAba] = frame
        abasBtns[nomeAba] = btn
        return frame
    end
    local abaScripts = criarAba("Scripts")
    local abaUtil = criarAba("Utilidades")
    local abaExtra = criarAba("Extras")
    local abaSocial = criarAba("Social")
    local abaTema = criarAba("Temas")
    criarCard(abaScripts, "Chilli Aura", "Aura visual", Theme.Chilli,
        "https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua", 1, "script")
    criarCard(abaScripts, "Miranda AFK", "Farm AFK automatico", Theme.Miranda,
        "https://raw.githubusercontent.com/miirandahub/loader/refs/heads/main/mirandaafk.lua", 2, "script")
    criarCard(abaScripts, "Lennon Farm", "Farm principal", Theme.Lennon,
        "https://raw.githubusercontent.com/lennonxscripts/lennonfarm/refs/heads/main/farmv1.lua", 3, "script")
    criarCard(abaScripts, "Lennon Hub V3", "Farm melhorado", Color3.fromRGB(200, 100, 255),
        "https://raw.githubusercontent.com/lennonxscripts/lennonhubv3/refs/heads/main/stealanegg.lua", 4, "script")
    criarCard(abaScripts, "Miranda Eggs", "Auto steal eggs", Color3.fromRGB(90, 180, 255),
        "https://raw.githubusercontent.com/miirandahub/loader/refs/heads/main/stealaeggs", 5, "script")
    criarCard(abaUtil, "Rejoin", "Reconectar no servidor", Theme.Accent3, nil, 1, "rejoin")
    criarCard(abaUtil, "Server Hop", "Trocar de servidor", Theme.Accent1, nil, 2, "hop")
    criarCard(abaUtil, "Discord", "Abrir nosso Discord", Theme.Discord, nil, 3, "discord")
    criarCard(abaUtil, "Play/Pause Musica", "Liga/desliga musica", Theme.Warning, nil, 4, "musica")
    criarCard(abaUtil, "Modo Streamer", "Esconde nomes", Theme.Accent2, nil, 5, "streamer")
    criarCard(abaUtil, "Fechar Tudo", "Fecha interfaces", Theme.Error, nil, 6, "fechartudo")
    criarCard(abaUtil, "Hide Players", "Esconde jogadores", Theme.Accent2, nil, 7, "hide")
    criarCard(abaUtil, "Anti-AFK", "Evita kick", Theme.Error, nil, 8, "antiafk")
    criarCard(abaUtil, "FPS Boost", "Melhora performance", Theme.Warning, nil, 9, "fpsboost")
    criarCard(abaUtil, "Copiar User ID", "Copia seu ID", Theme.Accent1, nil, 10, "userid")
    criarCard(abaUtil, "FullBright", "Brilho maximo", Theme.Warning, nil, 11, "fullbright")
    criarCard(abaUtil, "Reset", "Resetar personagem", Theme.Error, nil, 12, "reset")
    criarCard(abaUtil, "Ver Ping", "Latencia atual", Theme.Success, nil, 13, "ping")
    criarCard(abaUtil, "Speed Leve", "Velocidade leve", Theme.Success, nil, 14, "speed")
    criarCard(abaUtil, "Fly 5s", "Voar por 5 segundos", Theme.Accent1, nil, 15, "fly")
    criarCard(abaUtil, "Noclip", "Atravessa paredes", Theme.Warning, nil, 16, "noclip")
    criarCard(abaUtil, "Anti-Void", "Salva se cair do mapa", Theme.Success, nil, 17, "antivoid")
    criarCard(abaExtra, "Sala VIP", "Area premium", Theme.Gold, nil, 1, "salavip")
    criarCard(abaExtra, "Escolher Musica", "Mude a trilha", Theme.Warning, nil, 2, "escolhermusica")
    criarCard(abaExtra, "Pesquisa", "O que achou?", Theme.Accent1, nil, 3, "pesquisa")
    criarCard(abaExtra, "Historico", "Scripts executados", Theme.Accent3, nil, 4, "historico")
    criarCard(abaExtra, "Teleportes", "Ir pra locais", Theme.Accent2, nil, 5, "teleportes")
    criarCard(abaExtra, "Mini-Game", "Clique rapido", Theme.Success, nil, 6, "minigame")
    criarCard(abaExtra, "Conquistas", "Ver progresso", Theme.Gold, nil, 7, "conquistas")
    criarCard(abaExtra, "Comprar VIP", "Apoie o projeto", Theme.Success, nil, 8, "comprar")
    criarCard(abaExtra, "Sobre o Hub", "Informacoes", Theme.Accent3, nil, 9, "sobre")
    criarCard(abaSocial, "Lista de Jogadores", "Ve todos e teleporta", Theme.Accent1, nil, 1, "listajogadores")
    criarCard(abaSocial, "Add All Friends", "Segue todos", Theme.Discord, nil, 2, "social")
    criarCard(abaSocial, "Perfil", "Seu nivel e stats", Theme.Gold, nil, 3, "perfil")
    criarCard(abaSocial, "Hotkeys", "Configure teclas", Theme.Accent3, nil, 4, "hotkeys")
    local i = 1
    for nome, t in pairs(Temas) do
        criarCard(abaTema, "Tema " .. nome, "Cor " .. nome, t.a1, nome, i, "tema")
        i = i + 1
    end
    trocarAba("Scripts")
    task.spawn(function()
        while painelGui and painelGui.Parent do
            local fps = math.floor(1 / RunSvc.RenderStepped:Wait())
            local hora = os.date("%H:%M:%S")
            if relogio and relogio.Parent then
                relogio.Text = hora
                fpsLbl.Text = fps .. " FPS"
                nivelLbl.Text = "Nivel " .. Nivel .. " (" .. XP .. " XP)"
            end
            task.wait(0.5)
        end
    end)
    sBox:GetPropertyChangedSignal("Text"):Connect(function()
        local termo = string.lower(sBox.Text)
        for nome, dados in pairs(cardsGlobais) do
            if termo == "" then
                dados.card.Visible = true
            else
                local match = string.find(string.lower(nome), termo) or string.find(string.lower(dados.desc), termo)
                dados.card.Visible = match ~= nil
            end
        end
    end)
    closeBtn.MouseButton1Click:Connect(function()
        sClick()
        painelGui:Destroy()
        pararMusica()
    end)
    local minimizado = false
    minBtn.MouseButton1Click:Connect(function()
        sClick()
        minimizado = not minimizado
        if minimizado then
            Main.Size = UDim2.new(0, 800, 0, 80)
            sFrame.Visible = false
            content.Visible = false
            menuFrame.Visible = false
        else
            Main.Size = UDim2.new(0, 800, 0, 460)
            sFrame.Visible = true
            content.Visible = true
            menuFrame.Visible = true
        end
    end)
    UIS.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == Enum.KeyCode.F1 then
            if painelGui then
                painelGui.Enabled = not painelGui.Enabled
            end
            local n = CoreGui:FindFirstChild("PBL_Notif")
            if n then n:Destroy() end
        end
    end)
end

local verificando = false
local function verificar()
    if verificando then return end
    verificando = true
    if kInput.Text == CONFIG.Key then
        sSucesso()
        kBtn.Text = "CORRETA"
        task.wait(0.5)
        pcall(function() keyGui:Destroy() end)
        task.wait(0.2)
        pcall(telaObrigado, function()
            boasVindasEpica(function()
                local ok, err = pcall(criarPainel)
                if not ok then
                    warn("[PBL] " .. tostring(err))
                    notificar("Erro: " .. tostring(err):sub(1, 60), Theme.Error)
                end
            end)
        end)
        verificando = false
    else
        sErro()
        kBtn.Text = "INVALIDA"
        kInput.Text = ""
        task.wait(1.2)
        kBtn.Text = "VERIFICAR"
        verificando = false
    end
end

kBtn.MouseButton1Click:Connect(verificar)
kInput.FocusLost:Connect(function(enter)
    if enter then verificar() end
end)

print("[PBL] Aguardando key... (key: " .. CONFIG.Key .. ")")
