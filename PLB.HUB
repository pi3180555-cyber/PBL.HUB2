local function criarPainel()
    painelGui = Instance.new("ScreenGui")
    painelGui.Name = "PBL_Panel"
    painelGui.Parent = CoreGui
    painelGui.IgnoreGuiInset = true
    painelGui.DisplayOrder = 400
    local Main = Instance.new("Frame")
    Main.Size = UDim2.new(0, 800, 0, 460)
    Main.Position = UDim2.new(0.5, -400, 0.5, -230)
    Main.BackgroundColor3 = Theme.Bg
    Main.BorderSizePixel = 0
    Main.Active = true
    Main.Draggable = true
    Main.Parent = painelGui
    corner(Main, 16)
    grad(Main, Theme.Bg, Theme.BgSoft, 90)
    stroke(Main, Theme.Accent1, 1.5, 0.35)
    local Sidebar = Instance.new("Frame")
    Sidebar.Size = UDim2.new(0, 200, 1, 0)
    Sidebar.BackgroundColor3 = Theme.BgSoft
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main
    corner(Sidebar, 16)
    local SidebarFix = Instance.new("Frame")
    SidebarFix.Size = UDim2.new(0, 20, 1, 0)
    SidebarFix.Position = UDim2.new(1, -20, 0, 0)
    SidebarFix.BackgroundColor3 = Theme.BgSoft
    SidebarFix.BorderSizePixel = 0
    SidebarFix.Parent = Sidebar
    local topBar = Instance.new("Frame")
    topBar.Size = UDim2.new(1, 0, 0, 3)
    topBar.BorderSizePixel = 0
    topBar.Parent = Sidebar
    corner(topBar, 3)
    local topBarGrad = grad(topBar, Theme.Accent1, Theme.Accent2, 0)
    task.spawn(function()
        local rot = 0
        while topBar.Parent do
            rot = (rot + 3) % 360
            topBarGrad.Rotation = rot
            task.wait(0.05)
        end
    end)
    local avatarAura = Instance.new("Frame")
    avatarAura.Size = UDim2.new(0, 72, 0, 72)
    avatarAura.Position = UDim2.new(0.5, -36, 0, 12)
    avatarAura.BackgroundColor3 = Theme.Accent1
    avatarAura.BackgroundTransparency = 0.85
    avatarAura.BorderSizePixel = 0
    avatarAura.Parent = Sidebar
    corner(avatarAura, 36)
    task.spawn(function()
        while avatarAura.Parent do
            TweenSvc:Create(avatarAura, TweenInfo.new(1.5, Enum.EasingStyle.Sine), {BackgroundTransparency = 0.6}):Play()
            task.wait(1.5)
            if not avatarAura.Parent then break end
            TweenSvc:Create(avatarAura, TweenInfo.new(1.5, Enum.EasingStyle.Sine), {BackgroundTransparency = 0.9}):Play()
            task.wait(1.5)
        end
    end)
    local avatar = Instance.new("ImageLabel")
    avatar.Size = UDim2.new(0, 60, 0, 60)
