    local titulo = Instance.new("TextLabel")
    titulo.Size = UDim2.new(1, -20, 0, 32)
    titulo.Position = UDim2.new(0, 10, 0, 122)
    titulo.BackgroundTransparency = 1
    titulo.Text = "BEM VINDO AO PBL HUB"
    titulo.TextColor3 = Theme.Text
    titulo.TextSize = 21
    titulo.Font = Enum.Font.GothamBlack
    titulo.ZIndex = 6
    titulo.Parent = f
    local tg = Instance.new("UIGradient")
    tg.Color = ColorSequence.new(Theme.Accent1, Theme.Accent2)
    tg.Parent = titulo
    local sub1 = Instance.new("TextLabel")
    sub1.Size = UDim2.new(1, -20, 0, 18)
    sub1.Position = UDim2.new(0, 10, 0, 158)
    sub1.BackgroundTransparency = 1
    sub1.Text = "E uma honra ter voce aqui"
    sub1.TextColor3 = Theme.Pink
    sub1.TextSize = 12
    sub1.Font = Enum.Font.GothamSemibold
    sub1.ZIndex = 6
    sub1.Parent = f
    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(0, 380, 0, 5)
    barBg.Position = UDim2.new(0.5, -190, 1, -28)
    barBg.BackgroundColor3 = Theme.BgSoft
    barBg.BorderSizePixel = 0
    barBg.ZIndex = 6
    barBg.Parent = f
    corner(barBg, 3)
    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Theme.Accent1
    barFill.BorderSizePixel = 0
    barFill.ZIndex = 7
    barFill.Parent = barBg
    corner(barFill, 3)
    grad(barFill, Theme.Accent1, Theme.Accent2, 0)
    sSucesso()
    shakeTela(8, 0.4)
    TweenSvc:Create(barFill, TweenInfo.new(2.5, Enum.EasingStyle.Quad), {Size = UDim2.new(1, 0, 1, 0)}):Play()
    task.wait(3)
    TweenSvc:Create(f, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    TweenSvc:Create(ov, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
    TweenSvc:Create(coracao, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
    for _, c in ipairs(f:GetDescendants()) do
        if c:IsA("TextLabel") then TweenSvc:Create(c, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
        elseif c:IsA("ImageLabel") then TweenSvc:Create(c, TweenInfo.new(0.3), {ImageTransparency = 1}):Play()
        elseif c:IsA("Frame") then TweenSvc:Create(c, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play() end
    end
    task.wait(0.6)
    g:Destroy()
    if callback then callback() end
end

-- ═══════════════════════════════════════════════════════════
-- BEM VINDO AO PBL HUB
-- ═══════════════════════════════════════════════════════════
local function bemVindoPBL(nomeScript, callback)
    local g = Instance.new("ScreenGui")
    g.Name = "PBL_BemVindo"
    g.Parent = CoreGui
    g.IgnoreGuiInset = true
    g.DisplayOrder = 700
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = 1
    ov.BorderSizePixel = 0
    ov.ZIndex = 1
    ov.Parent = g
    TweenSvc:Create(ov, TweenInfo.new(0.4), {BackgroundTransparency = 0.45}):Play()
    animarBonequinhos(g)
    local coracao = animarCoracao(g)
    animarConfetes(g)
    local bigText = Instance.new("TextLabel")
    bigText.Size = UDim2.new(1, 0, 0, 50)
    bigText.Position = UDim2.new(0, 0, 0.5, -200)
    bigText.BackgroundTransparency = 1
    bigText.Text = "BEM VINDO AO"
    bigText.TextColor3 = Theme.TextDim
    bigText.TextSize = 36
    bigText.Font = Enum.Font.GothamBlack
    bigText.TextTransparency = 1
    bigText.ZIndex = 5
    bigText.Parent = g
    local bigTitle = Instance.new("TextLabel")
    bigTitle.Size = UDim2.new(1, 0, 0, 180)
    bigTitle.Position = UDim2.new(0, 0, 0.5, -140)
    bigTitle.BackgroundTransparency = 1
    bigTitle.Text = "PBL HUB"
    bigTitle.TextColor3 = Theme.Text
    bigTitle.TextSize = 140
    bigTitle.Font = Enum.Font.GothamBlack
    bigTitle.TextTransparency = 1
    bigTitle.ZIndex = 5
    bigTitle.Parent = g
    local tGrad = Instance.new("UIGradient")
    tGrad.Color = ColorSequence.new(Theme.Accent1, Theme.Accent2)
    tGrad.Parent = bigTitle
    local subTxt = Instance.new("TextLabel")
    subTxt.Size = UDim2.new(1, 0, 0, 26)
    subTxt.Position = UDim2.new(0, 0, 0.5, 55)
    subTxt.BackgroundTransparency = 1
    subTxt.Text = "Carregando " .. nomeScript
    subTxt.TextColor3 = Theme.Success
    subTxt.TextSize = 16
    subTxt.Font = Enum.Font.GothamSemibold
    subTxt.TextTransparency = 1
    subTxt.ZIndex = 5
    subTxt.Parent = g
    local barBg = Instance.new("Frame")
    barBg.Size = UDim2.new(0, 460, 0, 5)
    barBg.Position = UDim2.new(0.5, -230, 0.5, 110)
    barBg.BackgroundColor3 = Theme.BgSoft
    barBg.BackgroundTransparency = 1
    barBg.BorderSizePixel = 0
    barBg.ZIndex = 5
    barBg.Parent = g
    corner(barBg, 3)
    local barFill = Instance.new("Frame")
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Theme.Accent1
    barFill.BackgroundTransparency = 1
    barFill.BorderSizePixel = 0
    barFill.ZIndex = 6
    barFill.Parent = barBg
    corner(barFill, 3)
    grad(barFill, Theme.Accent1, Theme.Accent2, 0)
    task.spawn(function()
        sBoom()
        shakeTela(20, 0.7)
        task.wait(0.4)
        TweenSvc:Create(bigText, TweenInfo.new(0.4), {TextTransparency = 0}):Play()
        task.wait(0.3)
        bigTitle.TextSize = 20
        bigTitle.TextTransparency = 0
        TweenSvc:Create(bigTitle, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {TextSize = 140}):Play()
        sSucesso()
        task.wait(0.4)
        TweenSvc:Create(subTxt, TweenInfo.new(0.3), {TextTransparency = 0}):Play()
        TweenSvc:Create(barBg, TweenInfo.new(0.2), {BackgroundTransparency = 0.3}):Play()
        TweenSvc:Create(barFill, TweenInfo.new(1.5, Enum.EasingStyle.Quad), {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 0
        }):Play()
        task.wait(2.5)
        TweenSvc:Create(bigText, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        TweenSvc:Create(bigTitle, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        TweenSvc:Create(subTxt, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        TweenSvc:Create(barBg, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        TweenSvc:Create(barFill, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        TweenSvc:Create(ov, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        TweenSvc:Create(coracao, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        task.wait(0.6)
        g:Destroy()
        if callback then callback() end
    end)
end

-- ═══════════════════════════════════════════════════════════
-- LISTA DE JOGADORES
-- ═══════════════════════════════════════════════════════════
local function abrirListaJogadores()
    local lGui = Instance.new("ScreenGui")
    lGui.Name = "PBL_PlayerList"
    lGui.Parent = CoreGui
    lGui.IgnoreGuiInset = true
    lGui.DisplayOrder = 880
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = 0.55
    ov.BorderSizePixel = 0
    ov.Parent = lGui
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 480, 0, 440)
    f.Position = UDim2.new(0.5, -240, 0.5, -220)
    f.BackgroundColor3 = Theme.Bg
    f.BorderSizePixel = 0
    f.Parent = lGui
    corner(f, 16)
    grad(f, Theme.Bg, Theme.Card, 45)
    stroke(f, Theme.Accent1, 1.5, 0.2)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -20, 0, 28)
    t.Position = UDim2.new(0, 10, 0, 15)
    t.BackgroundTransparency = 1
    t.Text = "JOGADORES NA SALA (" .. #Players:GetPlayers() .. ")"
    t.TextColor3 = Theme.Text
    t.TextSize = 14
    t.Font = Enum.Font.GothamBlack
    t.Parent = f
    local cont = Instance.new("ScrollingFrame")
    cont.Size = UDim2.new(1, -30, 1, -80)
    cont.Position = UDim2.new(0, 15, 0, 55)
    cont.BackgroundTransparency = 1
    cont.BorderSizePixel = 0
    cont.ScrollBarThickness = 3
    cont.ScrollBarImageColor3 = Theme.Accent1
    cont.CanvasSize = UDim2.new(0, 0, 0, 0)
    cont.Parent = f
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, 5)
    l.Parent = cont
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        cont.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 10)
    end)
    for _, plr in ipairs(Players:GetPlayers()) do
        local isMe = plr == LP
        local item = Instance.new("TextButton")
        item.Size = UDim2.new(1, 0, 0, 50)
        item.BackgroundColor3 = isMe and Color3.fromRGB(35, 25, 50) or Theme.Card
        item.Text = ""
        item.BorderSizePixel = 0
        item.AutoButtonColor = false
        item.Parent = cont
        corner(item, 8)
        stroke(item, isMe and Theme.Accent1 or Theme.TextDim, 1, 0.5)
        local av = Instance.new("ImageLabel")
        av.Size = UDim2.new(0, 36, 0, 36)
        av.Position = UDim2.new(0, 10, 0.5, -18)
        av.BackgroundColor3 = Theme.BgSoft
        av.BorderSizePixel = 0
        av.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. plr.UserId .. "&width=150&height=150&format=png"
        av.Parent = item
        corner(av, 18)
        local nomeLbl = Instance.new("TextLabel")
        nomeLbl.Size = UDim2.new(1, -120, 0, 18)
        nomeLbl.Position = UDim2.new(0, 55, 0, 8)
        nomeLbl.BackgroundTransparency = 1
        nomeLbl.Text = plr.DisplayName .. (isMe and " (voce)" or "")
        nomeLbl.TextColor3 = Theme.Text
        nomeLbl.TextSize = 12
        nomeLbl.Font = Enum.Font.GothamBold
        nomeLbl.TextXAlignment = Enum.TextXAlignment.Left
        nomeLbl.Parent = item
        local subLbl = Instance.new("TextLabel")
        subLbl.Size = UDim2.new(1, -120, 0, 14)
        subLbl.Position = UDim2.new(0, 55, 0, 26)
        subLbl.BackgroundTransparency = 1
        subLbl.Text = "@" .. plr.Name
        subLbl.TextColor3 = Theme.TextDim
        subLbl.TextSize = 10
        subLbl.Font = Enum.Font.Gotham
        subLbl.TextXAlignment = Enum.TextXAlignment.Left
        subLbl.Parent = item
        if not isMe then
            item.MouseEnter:Connect(function() sHover() end)
            item.MouseButton1Click:Connect(function()
                sClick()
                pcall(function()
                    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    local alvoHRP = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and alvoHRP then
                        hrp.CFrame = alvoHRP.CFrame + Vector3.new(0, 3, 3)
                        notificar("Teleportado para " .. plr.DisplayName, Theme.Success)
                    end
                end)
            end)
        end
    end
    local fechar = Instance.new("TextButton")
    fechar.Size = UDim2.new(1, -30, 0, 34)
    fechar.Position = UDim2.new(0, 15, 1, -45)
    fechar.BackgroundColor3 = Theme.Error
    fechar.Text = "FECHAR"
    fechar.TextColor3 = Theme.Text
    fechar.TextSize = 11
    fechar.Font = Enum.Font.GothamBold
    fechar.BorderSizePixel = 0
    fechar.AutoButtonColor = false
    fechar.Parent = f
    corner(fechar, 8)
    fechar.MouseEnter:Connect(function() sHover() end)
    fechar.MouseButton1Click:Connect(function() sClick() lGui:Destroy() end)
end

-- ═══════════════════════════════════════════════════════════
-- ANTI-VOID
-- ═══════════════════════════════════════════════════════════
local function toggleAntiVoid()
    antiVoidAtivo = not antiVoidAtivo
    if antiVoidAtivo then
        notificar("Anti-Void ATIVADO", Theme.Success)
        task.spawn(function()
            while antiVoidAtivo do
                pcall(function()
                    local char = LP.Character
                    if not char then return end
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp and hrp.Position.Y < -50 then
                        hrp.CFrame = CFrame.new(0, 50, 0)
                        notificar("Anti-Void salvou voce!", Theme.Warning)
                    end
                end)
                task.wait(math.random(2, 5))
            end
        end)
    else
        notificar("Anti-Void DESATIVADO", Theme.Warning)
    end
end

-- ═══════════════════════════════════════════════════════════
-- HOTKEYS
-- ═══════════════════════════════════════════════════════════
local function abrirHotkeys()
    local hGui = Instance.new("ScreenGui")
    hGui.Name = "PBL_Hotkeys"
    hGui.Parent = CoreGui
    hGui.IgnoreGuiInset = true
    hGui.DisplayOrder = 890
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = 0.55
    ov.BorderSizePixel = 0
    ov.Parent = hGui
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 500, 0, 400)
    f.Position = UDim2.new(0.5, -250, 0.5, -200)
    f.BackgroundColor3 = Theme.Bg
    f.BorderSizePixel = 0
    f.Parent = hGui
    corner(f, 16)
    grad(f, Theme.Bg, Theme.Card, 45)
    stroke(f, Theme.Accent1, 1.5, 0.2)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -20, 0, 28)
    t.Position = UDim2.new(0, 10, 0, 15)
    t.BackgroundTransparency = 1
    t.Text = "SISTEMA DE HOTKEYS"
    t.TextColor3 = Theme.Text
    t.TextSize = 14
    t.Font = Enum.Font.GothamBlack
    t.Parent = f
    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(1, -20, 0, 14)
    sub.Position = UDim2.new(0, 10, 0, 42)
    sub.BackgroundTransparency = 1
    sub.Text = "Digite a tecla para cada script"
    sub.TextColor3 = Theme.TextDim
    sub.TextSize = 10
    sub.Font = Enum.Font.Gotham
    sub.Parent = f
    local scriptsHotkey = {"Chilli Aura", "Miranda AFK", "Lennon Farm"}
    local y = 75
    for _, nomeScript in ipairs(scriptsHotkey) do
        local item = Instance.new("Frame")
        item.Size = UDim2.new(1, -30, 0, 45)
        item.Position = UDim2.new(0, 15, 0, y)
        item.BackgroundColor3 = Theme.Card
        item.BorderSizePixel = 0
        item.Parent = f
        corner(item, 8)
        stroke(item, Theme.Accent1, 1, 0.5)
        local nomeLbl = Instance.new("TextLabel")
        nomeLbl.Size = UDim2.new(0.5, 0, 1, 0)
        nomeLbl.Position = UDim2.new(0, 10, 0, 0)
        nomeLbl.BackgroundTransparency = 1
        nomeLbl.Text = nomeScript
        nomeLbl.TextColor3 = Theme.Text
        nomeLbl.TextSize = 12
        nomeLbl.Font = Enum.Font.GothamBold
        nomeLbl.TextXAlignment = Enum.TextXAlignment.Left
        nomeLbl.Parent = item
        local keyBox = Instance.new("TextBox")
        keyBox.Size = UDim2.new(0, 70, 0, 30)
        keyBox.Position = UDim2.new(1, -85, 0.5, -15)
        keyBox.BackgroundColor3 = Theme.BgSoft
        keyBox.Text = hotkeys[nomeScript] or ""
        keyBox.TextColor3 = Theme.Accent1
        keyBox.TextSize = 14
        keyBox.Font = Enum.Font.GothamBold
        keyBox.BorderSizePixel = 0
        keyBox.ClearTextOnFocus = false
        keyBox.Parent = item
        corner(keyBox, 6)
        stroke(keyBox, Theme.Accent1, 1, 0.5)
        keyBox.FocusLost:Connect(function()
            local nova = string.upper(keyBox.Text):sub(1, 1)
            if #nova > 0 then
                hotkeys[nomeScript] = nova
                keyBox.Text = nova
                notificar(nomeScript .. " agora e tecla " .. nova, Theme.Success)
                sSucesso()
            end
        end)
        y = y + 55
    end
    local fechar = Instance.new("TextButton")
    fechar.Size = UDim2.new(1, -30, 0, 34)
    fechar.Position = UDim2.new(0, 15, 1, -45)
    fechar.BackgroundColor3 = Theme.Error
    fechar.Text = "FECHAR"
    fechar.TextColor3 = Theme.Text
    fechar.TextSize = 11
    fechar.Font = Enum.Font.GothamBold
    fechar.BorderSizePixel = 0
    fechar.AutoButtonColor = false
    fechar.Parent = f
    corner(fechar, 8)
    fechar.MouseEnter:Connect(function() sHover() end)
    fechar.MouseButton1Click:Connect(function() sClick() hGui:Destroy() end)
end

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end
    local tecla = input.KeyCode.Name
    for nomeScript, teclaBind in pairs(hotkeys) do
        if tecla == teclaBind then
            sClick()
            notificar("Hotkey: " .. nomeScript, Theme.Accent1)
        end
    end
    if input.KeyCode == CONFIG.TeclaEsconder then
        painelVisivel = not painelVisivel
        if painelGui then
            painelGui.Enabled = painelVisivel
            notificar(painelVisivel and "Painel visivel" or "Painel escondido", Theme.Accent3)
        end
    end
end)

