local function tocarMusicaIndice(idx)
    pcall(function()
        if musica then musica:Destroy() end
        local m = Musicas[idx]
        if not m then return end
        local s = Instance.new("Sound")
        s.SoundId = m.id
        s.Volume = 0.35
        s.Looped = true
        s.Parent = SoundSvc
        s:Play()
        musica = s
        musicaPausada = false
        CONFIG.MusicaAtual = idx
        CONFIG.MusicaID = m.id
    end)
end

local function pararMusica()
    pcall(function()
        if musica then
            musica:Stop()
            musica:Destroy()
            musica = nil
        end
    end)
end

local function toggleMusica()
    if not musica then tocarMusicaIndice(CONFIG.MusicaAtual) return true end
    if musicaPausada then
        musica:Resume()
        musicaPausada = false
        return true
    else
        musica:Pause()
        musicaPausada = true
        return false
    end
end

local function notificar(msg, cor)
    pcall(function()
        local old = CoreGui:FindFirstChild("PBL_Notif")
        if old then old:Destroy() end
        local g = Instance.new("ScreenGui")
        g.Name = "PBL_Notif"
        g.Parent = CoreGui
        g.IgnoreGuiInset = true
        g.DisplayOrder = 9999
        local f = Instance.new("Frame")
        f.Size = UDim2.new(0, 320, 0, 52)
        f.Position = UDim2.new(0.5, -160, 0, 25)
        f.BackgroundColor3 = Theme.Card
        f.BorderSizePixel = 0
        f.Parent = g
        corner(f, 10)
        stroke(f, cor, 1.5, 0.3)
        local b = Instance.new("Frame")
        b.Size = UDim2.new(0, 3, 1, 0)
        b.BackgroundColor3 = cor
        b.BorderSizePixel = 0
        b.Parent = f
        corner(b, 10)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -25, 1, 0)
        l.Position = UDim2.new(0, 18, 0, 0)
        l.BackgroundTransparency = 1
        l.Text = msg
        l.TextColor3 = Theme.Text
        l.TextSize = 13
        l.Font = Enum.Font.GothamMedium
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.TextWrapped = true
        l.Parent = f
        task.delay(3, function() if g then g:Destroy() end end)
    end)
end

local function shakeTela(forca, dur)
    local cam = workspace.CurrentCamera
    if not cam then return end
    local orig = cam.CFrame
    for i = 1, 20 do
        local f = forca * (1 - i/20)
        cam.CFrame = orig * CFrame.new(math.random(-f, f)/100, math.random(-f, f)/100, math.random(-f, f)/100)
        task.wait(dur/20)
    end
    cam.CFrame = orig
end

local function criarBonequinho(parentGui, cor)
    local b = Instance.new("Frame")
    b.Size = UDim2.new(0, 20, 0, 30)
    b.BackgroundTransparency = 1
    b.BorderSizePixel = 0
    b.ZIndex = 3
    b.Parent = parentGui
    local cabeca = Instance.new("Frame")
    cabeca.Size = UDim2.new(0, 12, 0, 12)
    cabeca.Position = UDim2.new(0.5, -6, 0, 0)
    cabeca.BackgroundColor3 = cor
    cabeca.BorderSizePixel = 0
    cabeca.Parent = b
    corner(cabeca, 6)
    local corpo = Instance.new("Frame")
    corpo.Size = UDim2.new(0, 8, 0, 12)
    corpo.Position = UDim2.new(0.5, -4, 0, 13)
    corpo.BackgroundColor3 = cor
    corpo.BorderSizePixel = 0
    corpo.Parent = b
    corner(corpo, 3)
    local pe = Instance.new("Frame")
    pe.Size = UDim2.new(0, 3, 0, 6)
    pe.Position = UDim2.new(0.5, -4, 1, -6)
    pe.BackgroundColor3 = cor
    pe.BorderSizePixel = 0
    pe.Parent = b
    corner(pe, 2)
    local pd = Instance.new("Frame")
    pd.Size = UDim2.new(0, 3, 0, 6)
    pd.Position = UDim2.new(0.5, 1, 1, -6)
    pd.BackgroundColor3 = cor
    pd.BorderSizePixel = 0
    pd.Parent = b
    corner(pd, 2)
    local be = Instance.new("Frame")
    be.Size = UDim2.new(0, 3, 0, 8)
    be.Position = UDim2.new(0, -2, 0, 15)
    be.BackgroundColor3 = cor
    be.BorderSizePixel = 0
    be.Parent = b
    corner(be, 2)
    local bd = Instance.new("Frame")
    bd.Size = UDim2.new(0, 3, 0, 8)
    bd.Position = UDim2.new(1, -1, 0, 15)
    bd.BackgroundColor3 = cor
    bd.BorderSizePixel = 0
    bd.Parent = b
    corner(bd, 2)
    task.spawn(function()
        local alt = false
        while b.Parent do
            alt = not alt
            if alt then
                TweenSvc:Create(pe, TweenInfo.new(0.2), {Rotation = 15}):Play()
                TweenSvc:Create(pd, TweenInfo.new(0.2), {Rotation = -15}):Play()
                TweenSvc:Create(be, TweenInfo.new(0.2), {Rotation = -20}):Play()
                TweenSvc:Create(bd, TweenInfo.new(0.2), {Rotation = 20}):Play()
            else
                TweenSvc:Create(pe, TweenInfo.new(0.2), {Rotation = -15}):Play()
                TweenSvc:Create(pd, TweenInfo.new(0.2), {Rotation = 15}):Play()
                TweenSvc:Create(be, TweenInfo.new(0.2), {Rotation = 20}):Play()
                TweenSvc:Create(bd, TweenInfo.new(0.2), {Rotation = -20}):Play()
            end
            task.wait(0.2)
        end
    end)
    return b
end

local coresBonequinho = {
    Color3.fromRGB(255, 100, 150), Color3.fromRGB(155, 89, 255),
    Color3.fromRGB(80, 200, 255), Color3.fromRGB(46, 230, 140),
    Color3.fromRGB(255, 190, 60), Color3.fromRGB(255, 60, 172)
}

local function animarBonequinhos(g)
    task.spawn(function()
        for i = 1, 6 do
            local b = criarBonequinho(g, coresBonequinho[i])
            local lado = (i - 1) % 4
            local posIni, posFim
            if lado == 0 then
                posIni = UDim2.new(-0.1, 0, 0, 10)
                posFim = UDim2.new(1.1, 0, 0, 10)
            elseif lado == 1 then
                b.Rotation = -90
                posIni = UDim2.new(1, -35, -0.1, 0)
                posFim = UDim2.new(1, -35, 1.1, 0)
            elseif lado == 2 then
                posIni = UDim2.new(1.1, 0, 1, -45)
                posFim = UDim2.new(-0.1, 0, 1, -45)
            else
                b.Rotation = 90
                posIni = UDim2.new(0, 15, 1.1, 0)
                posFim = UDim2.new(0, 15, -0.1, 0)
            end
            b.Position = posIni
            TweenSvc:Create(b, TweenInfo.new(4.5, Enum.EasingStyle.Linear), {Position = posFim}):Play()
            task.wait(0.3)
        end
    end)
end

local function animarCoracao(g)
    local coracao = Instance.new("TextLabel")
    coracao.Size = UDim2.new(0, 60, 0, 60)
    coracao.Position = UDim2.new(1, -90, 0, 25)
    coracao.BackgroundTransparency = 1
    coracao.Text = "♥"
    coracao.TextColor3 = Theme.Pink
    coracao.TextSize = 42
    coracao.Font = Enum.Font.GothamBold
    coracao.ZIndex = 4
    coracao.Parent = g
    task.spawn(function()
        while coracao.Parent do
            TweenSvc:Create(coracao, TweenInfo.new(0.35), {TextSize = 52}):Play()
            task.wait(0.35)
            if not coracao.Parent then break end
            TweenSvc:Create(coracao, TweenInfo.new(0.35), {TextSize = 42}):Play()
            task.wait(0.35)
        end
    end)
    return coracao
end

local function animarConfetes(g)
    local coresConfete = {
        Color3.fromRGB(255, 100, 150), Color3.fromRGB(155, 89, 255),
        Color3.fromRGB(80, 200, 255), Color3.fromRGB(46, 230, 140),
        Color3.fromRGB(255, 190, 60), Color3.fromRGB(255, 60, 172)
    }
    task.spawn(function()
        for _ = 1, 50 do
            local conf = Instance.new("Frame")
            local tam = math.random(4, 8)
            conf.Size = UDim2.new(0, tam, 0, tam)
            conf.Position = UDim2.new(math.random(), 0, -0.05, 0)
            conf.BackgroundColor3 = coresConfete[math.random(#coresConfete)]
            conf.BorderSizePixel = 0
            conf.ZIndex = 2
            conf.Parent = g
            corner(conf, tam)
            TweenSvc:Create(conf, TweenInfo.new(2.5 + math.random()*2, Enum.EasingStyle.Linear), {
                Position = UDim2.new(math.random(), 0, 1.05, 0)
            }):Play()
            task.delay(5, function() if conf then conf:Destroy() end end)
            task.wait(0.05)
        end
    end)
    task.spawn(function()
        for _ = 1, 15 do
            local cor = Instance.new("TextLabel")
            cor.Size = UDim2.new(0, 20, 0, 20)
            cor.Position = UDim2.new(math.random(), 0, -0.05, 0)
            cor.BackgroundTransparency = 1
            cor.Text = "♥"
            cor.TextColor3 = Theme.Pink
            cor.TextSize = math.random(14, 24)
            cor.Font = Enum.Font.GothamBold
            cor.ZIndex = 2
            cor.Parent = g
            TweenSvc:Create(cor, TweenInfo.new(3 + math.random()*2, Enum.EasingStyle.Linear), {
                Position = UDim2.new(math.random(), 0, 1.05, 0)
            }):Play()
            task.delay(5, function() if cor then cor:Destroy() end end)
            task.wait(0.3)
        end
    end)
end

local function ganharXP(qtd)
    XP = XP + qtd
    if XP >= XPNecessario then
        XP = XP - XPNecessario
        Nivel = Nivel + 1
        XPNecessario = math.floor(XPNecessario * 1.5)
        sLevelUp()
        shakeTela(8, 0.3)
        notificar("NIVEL " .. Nivel .. "!", Theme.Gold)
    end
end-- ═══════════════════════════════════════════════════════════
