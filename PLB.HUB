-- TELEPORTES
-- ═══════════════════════════════════════════════════════════
local function abrirTeleportes()
    local tGui = Instance.new("ScreenGui")
    tGui.Name = "PBL_Teleportes"
    tGui.Parent = CoreGui
    tGui.IgnoreGuiInset = true
    tGui.DisplayOrder = 840
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = 0.55
    ov.BorderSizePixel = 0
    ov.Parent = tGui
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 480, 0, 260)
    f.Position = UDim2.new(0.5, -240, 0.5, -130)
    f.BackgroundColor3 = Theme.Bg
    f.BorderSizePixel = 0
    f.Parent = tGui
    corner(f, 16)
    grad(f, Theme.Bg, Theme.Card, 45)
    stroke(f, Theme.Accent1, 1.5, 0.2)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -20, 0, 28)
    t.Position = UDim2.new(0, 10, 0, 15)
    t.BackgroundTransparency = 1
    t.Text = "TELEPORTES"
    t.TextColor3 = Theme.Text
    t.TextSize = 15
    t.Font = Enum.Font.GothamBlack
    t.Parent = f
    local grid = Instance.new("Frame")
    grid.Size = UDim2.new(1, -30, 1, -100)
    grid.Position = UDim2.new(0, 15, 0, 55)
    grid.BackgroundTransparency = 1
    grid.Parent = f
    local gridLayout = Instance.new("UIGridLayout")
    gridLayout.CellSize = UDim2.new(0, 215, 0, 50)
    gridLayout.CellPadding = UDim2.new(0, 6, 0, 6)
    gridLayout.Parent = grid
    local destinos = {
        {nome = "Ceu (Sky)", pos = Vector3.new(0, 500, 0)},
        {nome = "Subterraneo", pos = Vector3.new(0, -100, 0)},
        {nome = "Aleatorio", pos = nil},
        {nome = "Spawn", pos = "spawn"}
    }
    for _, d in ipairs(destinos) do
        local btn = Instance.new("TextButton")
        btn.BackgroundColor3 = Theme.Card
        btn.Text = ""
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Parent = grid
        corner(btn, 8)
        stroke(btn, Theme.Accent1, 1, 0.6)
        local barra = Instance.new("Frame")
        barra.Size = UDim2.new(0, 3, 1, 0)
        barra.BackgroundColor3 = Theme.Accent1
        barra.BorderSizePixel = 0
        barra.Parent = btn
        corner(barra, 8)
        local nl = Instance.new("TextLabel")
        nl.Size = UDim2.new(1, -20, 1, 0)
        nl.Position = UDim2.new(0, 15, 0, 0)
        nl.BackgroundTransparency = 1
        nl.Text = d.nome
        nl.TextColor3 = Theme.Text
        nl.TextSize = 11
        nl.Font = Enum.Font.GothamSemibold
        nl.TextXAlignment = Enum.TextXAlignment.Left
        nl.Parent = btn
        btn.MouseEnter:Connect(function() sHover() end)
        btn.MouseButton1Click:Connect(function()
            sClick()
            pcall(function()
                local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                if d.pos == "spawn" then
                    hrp.CFrame = CFrame.new(0, 50, 0)
                elseif d.pos == nil then
                    hrp.CFrame = CFrame.new(math.random(-500,500), 100, math.random(-500,500))
                else
                    hrp.CFrame = CFrame.new(d.pos)
                end
                notificar("Teleportado: " .. d.nome, Theme.Accent1)
                ganharXP(10)
            end)
        end)
    end
    local fechar = Instance.new("TextButton")
    fechar.Size = UDim2.new(1, -30, 0, 34)
    fechar.Position = UDim2.new(0, 15, 1, -45)
    fechar.BackgroundColor3 = Theme.Error
    fechar.Text = "FECHAR"
    fechar.TextColor3 = Theme.Text
    fechar.TextSize = 11
    fechar.Font = Enum.Font.GothamBold
    fechar.BorderSizePixel = 0
    fechar.AutoButtonColor = false
    fechar.Parent = f
    corner(fechar, 8)
    fechar.MouseEnter:Connect(function() sHover() end)
    fechar.MouseButton1Click:Connect(function() sClick() tGui:Destroy() end)
end

