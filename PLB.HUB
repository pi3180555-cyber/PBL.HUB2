    barraBg.Position = UDim2.new(0.5, -200, 0, 180)
    barraBg.BackgroundColor3 = Theme.BgSoft
    barraBg.BorderSizePixel = 0
    barraBg.Parent = f
    corner(barraBg, 6)
    local progresso = math.min(XP / XPNecessario, 1)
    local barraFill = Instance.new("Frame")
    barraFill.Size = UDim2.new(progresso, 0, 1, 0)
    barraFill.BackgroundColor3 = Theme.Accent1
    barraFill.BorderSizePixel = 0
    barraFill.Parent = barraBg
    corner(barraFill, 6)
    grad(barraFill, Theme.Accent1, Theme.Accent2, 0)
    local xpLbl = Instance.new("TextLabel")
    xpLbl.Size = UDim2.new(1, -20, 0, 18)
    xpLbl.Position = UDim2.new(0, 10, 0, 200)
    xpLbl.BackgroundTransparency = 1
    xpLbl.Text = XP .. " / " .. XPNecessario .. " XP"
    xpLbl.TextColor3 = Theme.TextDim
    xpLbl.TextSize = 11
    xpLbl.Font = Enum.Font.Gotham
    xpLbl.Parent = f
    local function contaFav()
        local c = 0
        for _ in pairs(favoritos) do c = c + 1 end
        return c
    end
    local stats = Instance.new("TextLabel")
    stats.Size = UDim2.new(1, -30, 1, -270)
    stats.Position = UDim2.new(0, 15, 0, 230)
    stats.BackgroundTransparency = 1
    stats.Text = "Scripts executados: " .. contadorScripts .. "\n" ..
        "Favoritos salvos: " .. contaFav() .. "\n" ..
        "Historico: " .. #historico .. " entradas\n" ..
        "Versao: " .. CONFIG.Versao
    stats.TextColor3 = Theme.TextSoft
    stats.TextSize = 11
    stats.Font = Enum.Font.Gotham
    stats.TextXAlignment = Enum.TextXAlignment.Left
    stats.TextYAlignment = Enum.TextYAlignment.Top
    stats.Parent = f
    local fechar = Instance.new("TextButton")
    fechar.Size = UDim2.new(1, -30, 0, 34)
