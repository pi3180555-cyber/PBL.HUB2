    cont.Parent = f
    local l = Instance.new("UIListLayout")
    l.Padding = UDim.new(0, 5)
    l.Parent = cont
    l:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        cont.CanvasSize = UDim2.new(0, 0, 0, l.AbsoluteContentSize.Y + 10)
    end)
    if #historico == 0 then
        local nada = Instance.new("TextLabel")
        nada.Size = UDim2.new(1, 0, 0, 40)
        nada.BackgroundTransparency = 1
        nada.Text = "Nenhum script executado"
        nada.TextColor3 = Theme.TextDim
        nada.TextSize = 11
        nada.Font = Enum.Font.Gotham
        nada.Parent = cont
    else
        for _, h in ipairs(historico) do
            local item = Instance.new("Frame")
            item.Size = UDim2.new(1, 0, 0, 34)
            item.BackgroundColor3 = Theme.Card
            item.BorderSizePixel = 0
            item.Parent = cont
            corner(item, 8)
            stroke(item, Theme.Accent1, 1, 0.6)
            local barra = Instance.new("Frame")
            barra.Size = UDim2.new(0, 3, 1, 0)
            barra.BackgroundColor3 = Theme.Accent1
            barra.BorderSizePixel = 0
            barra.Parent = item
            corner(barra, 8)
            local txt = Instance.new("TextLabel")
            txt.Size = UDim2.new(1, -20, 1, 0)
            txt.Position = UDim2.new(0, 15, 0, 0)
            txt.BackgroundTransparency = 1
            txt.Text = h
            txt.TextColor3 = Theme.Text
            txt.TextSize = 11
            txt.Font = Enum.Font.Gotham
            txt.TextXAlignment = Enum.TextXAlignment.Left
            txt.Parent = item
        end
    end
    local fechar = Instance.new("TextButton")
    fechar.Size = UDim2.new(1, -30, 0, 34)
    fechar.Position = UDim2.new(0, 15, 1, -45)
    fechar.BackgroundColor3 = Theme.Error
    fechar.Text = "FECHAR"
