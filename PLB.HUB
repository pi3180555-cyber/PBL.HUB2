-- MINI-GAME
-- ═══════════════════════════════════════════════════════════
local function abrirMiniGame()
    local mg = Instance.new("ScreenGui")
    mg.Name = "PBL_MiniGame"
    mg.Parent = CoreGui
    mg.IgnoreGuiInset = true
    mg.DisplayOrder = 860
    local ov = Instance.new("Frame")
    ov.Size = UDim2.new(1, 0, 1, 0)
    ov.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ov.BackgroundTransparency = 0.55
    ov.BorderSizePixel = 0
    ov.Parent = mg
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, 600, 0, 360)
    f.Position = UDim2.new(0.5, -300, 0.5, -180)
    f.BackgroundColor3 = Theme.Bg
    f.BorderSizePixel = 0
    f.Parent = mg
    corner(f, 16)
    grad(f, Theme.Bg, Theme.Card, 45)
    stroke(f, Theme.Accent1, 1.5, 0.2)
    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, -20, 0, 28)
    t.Position = UDim2.new(0, 10, 0, 15)
    t.BackgroundTransparency = 1
    t.Text = "MINI-GAME: CLIQUE RAPIDO"
    t.TextColor3 = Theme.Text
    t.TextSize = 15
    t.Font = Enum.Font.GothamBlack
    t.Parent = f
    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(1, -20, 0, 14)
    sub.Position = UDim2.new(0, 10, 0, 42)
    sub.BackgroundTransparency = 1
    sub.Text = "Tempo: 15s"
    sub.TextColor3 = Theme.TextDim
    sub.TextSize = 10
    sub.Font = Enum.Font.Gotham
    sub.Parent = f
    local pts = Instance.new("TextLabel")
    pts.Size = UDim2.new(1, -20, 0, 22)
    pts.Position = UDim2.new(0, 10, 0, 62)
    pts.BackgroundTransparency = 1
    pts.Text = "Pontos: 0"
    pts.TextColor3 = Theme.Success
    pts.TextSize = 15
    pts.Font = Enum.Font.GothamBlack
    pts.Parent = f
    local area = Instance.new("Frame")
    area.Size = UDim2.new(1, -30, 1, -145)
    area.Position = UDim2.new(0, 15, 0, 90)
    area.BackgroundColor3 = Theme.BgSoft
    area.BorderSizePixel = 0
    area.Parent = f
    corner(area, 10)
    local alvo = Instance.new("TextButton")
    alvo.Size = UDim2.new(0, 50, 0, 50)
    alvo.Position = UDim2.new(0.5, -25, 0.5, -25)
    alvo.BackgroundColor3 = Theme.Accent1
    alvo.Text = "X"
    alvo.TextSize = 20
    alvo.TextColor3 = Theme.Text
    alvo.Font = Enum.Font.GothamBlack
    alvo.BorderSizePixel = 0
    alvo.AutoButtonColor = false
    alvo.Parent = area
    corner(alvo, 25)
    grad(alvo, Theme.Accent1, Theme.Accent2, 45)
    local pontos = 0
    local tempo = 15
    local jogando = true
    alvo.MouseButton1Click:Connect(function()
        if not jogando then return end
        sClick()
        pontos = pontos + 1
        pts.Text = "Pontos: " .. pontos
        alvo.Position = UDim2.new(math.random(), -25, math.random(), -25)
    end)
    task.spawn(function()
        while tempo > 0 and jogando do
            task.wait(1)
            tempo = tempo - 1
            sub.Text = "Tempo: " .. tempo .. "s"
        end
        if jogando then
            jogando = false
            sSucesso()
            notificar("Fim! " .. pontos .. " pontos", Theme.Success)
            sub.Text = "FIM - Pontos: " .. pontos
            ganharXP(pontos * 5)
        end
    end)
    local fechar = Instance.new("TextButton")
    fechar.Size = UDim2.new(1, -30, 0, 34)
    fechar.Position = UDim2.new(0, 15, 1, -45)
    fechar.BackgroundColor3 = Theme.Error
    fechar.Text = "FECHAR"
    fechar.TextColor3 = Theme.Text
    fechar.TextSize = 11
    fechar.Font = Enum.Font.GothamBold
    fechar.BorderSizePixel = 0
    fechar.AutoButtonColor = false
    fechar.Parent = f
    corner(fechar, 8)
    fechar.MouseEnter:Connect(function() sHover() end)
    fechar.MouseButton1Click:Connect(function()
        sClick()
        jogando = false
        mg:Destroy()
    end)
end

