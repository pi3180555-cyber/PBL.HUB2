    -- ═══ SIDEBAR (lateral esquerda) ═══
    local Sidebar = Instance.new("Frame")
    Sidebar.Size = UDim2.new(0, 95, 1, -60)
    Sidebar.Position = UDim2.new(0, 0, 0, 60)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.BackgroundTransparency = 0.5
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main

    local SidebarLine = Instance.new("Frame")
    SidebarLine.Size = UDim2.new(0, 1, 1, 0)
    SidebarLine.Position = UDim2.new(1, -1, 0, 0)
    SidebarLine.BackgroundColor3 = Theme.Card
    SidebarLine.BackgroundTransparency = 0.5
    SidebarLine.BorderSizePixel = 0
    SidebarLine.Parent = Sidebar

    local SidebarList = Instance.new("UIListLayout")
    SidebarList.Padding = UDim.new(0, 4)
    SidebarList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    SidebarList.Parent = Sidebar

    local SidebarPad = Instance.new("UIPadding")
    SidebarPad.PaddingTop = UDim.new(0, 15)
    SidebarPad.Parent = Sidebar

    -- Função criar botão da sidebar
    local tabsAtivas = {}
    local conteudos = {}

    local function criarTab(nome, icone, id)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 78, 0, 58)
        btn.BackgroundColor3 = Theme.Sidebar
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Parent = Sidebar
        corner(btn, 8)

        local iconeLbl = Instance.new("TextLabel")
        iconeLbl.Size = UDim2.new(1, 0, 0, 24)
        iconeLbl.Position = UDim2.new(0, 0, 0, 8)
        iconeLbl.BackgroundTransparency = 1
        iconeLbl.Text = icone
        iconeLbl.TextSize = 20
        iconeLbl.Font = Enum.Font.GothamBold
        iconeLbl.TextColor3 = Theme.TextDim
        iconeLbl.Parent = btn

        local nomeLbl = Instance.new("TextLabel")
        nomeLbl.Size = UDim2.new(1, 0, 0, 14)
        nomeLbl.Position = UDim2.new(0, 0, 0, 36)
        nomeLbl.BackgroundTransparency = 1
        nomeLbl.Text = nome
        nomeLbl.TextSize = 9
        nomeLbl.Font = Enum.Font.GothamBold
        nomeLbl.TextColor3 = Theme.TextDim
        nomeLbl.Parent = btn

        btn.MouseEnter:Connect(function()
            if tabsAtivas[id] then return end
            sHover()
            TweenSvc:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.7}):Play()
            TweenSvc:Create(iconeLbl, TweenInfo.new(0.15), {TextColor3 = Theme.Text}):Play()
            TweenSvc:Create(nomeLbl, TweenInfo.new(0.15), {TextColor3 = Theme.Text}):Play()
        end)

        btn.MouseLeave:Connect(function()
            if tabsAtivas[id] then return end
            TweenSvc:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
            TweenSvc:Create(iconeLbl, TweenInfo.new(0.15), {TextColor3 = Theme.TextDim}):Play()
            TweenSvc:Create(nomeLbl, TweenInfo.new(0.15), {TextColor3 = Theme.TextDim}):Play()
        end)

        btn.MouseButton1Click:Connect(function()
            sClick()
            -- Desativa todos
            for k, v in pairs(tabsAtivas) do
                if v then
                    local b = v.btn
                    local i = v.icone
                    local n = v.nome
                    tabsAtivas[k] = nil
                    TweenSvc:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
                    TweenSvc:Create(i, TweenInfo.new(0.15), {TextColor3 = Theme.TextDim}):Play()
                    TweenSvc:Create(n, TweenInfo.new(0.15), {TextColor3 = Theme.TextDim}):Play()
                end
            end
            -- Ativa esse
            tabsAtivas[id] = {btn = btn, icone = iconeLbl, nome = nomeLbl}
            TweenSvc:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0}):Play()
            TweenSvc:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.SidebarActive}):Play()
            TweenSvc:Create(iconeLbl, TweenInfo.new(0.15), {TextColor3 = Theme.Text}):Play()
            TweenSvc:Create(nomeLbl, TweenInfo.new(0.15), {TextColor3 = Theme.Text}):Play()

            -- Troca aba
            for k, f in pairs(conteudos) do
                f.Visible = (k == id)
            end
        end)

        return btn
    end

    -- Cria as tabs
    criarTab("SCRIPTS", "📜", "scripts")
    criarTab("UTILS", "🔧", "utils")
    criarTab("INFO", "ℹ", "info")

    -- Ativa SCRIPTS por padrão
    for k, v in pairs(tabsAtivas) do tabsAtivas[k] = nil end
    tabsAtivas["scripts"] = true

    -- ═══ ÁREA DE CONTEÚDO ═══
    local Content = Instance.new("Frame")
    Content.Size = UDim2.new(1, -95, 1, -60)
    Content.Position = UDim2.new(0, 95, 0, 60)
    Content.BackgroundTransparency = 1
    Content.Parent = Main

    -- Função criar conteúdo de aba
    local function criarConteudo(id, titulo, subtitulo)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 1
        frame.Visible = (id == "scripts")
        frame.Parent = Content
        conteudos[id] = frame

        -- Header interno
        local innerHeader = Instance.new("Frame")
        innerHeader.Size = UDim2.new(1, -30, 0, 45)
        innerHeader.Position = UDim2.new(0, 15, 0, 10)
        innerHeader.BackgroundTransparency = 1
        innerHeader.Parent = frame

        local hIcon = Instance.new("TextLabel")
        hIcon.Size = UDim2.new(0, 20, 0, 20)
        hIcon.Position = UDim2.new(0, 0, 0, 5)
        hIcon.BackgroundTransparency = 1
        hIcon.Text = "☰"
        hIcon.TextSize = 18
        hIcon.Font = Enum.Font.GothamBold
        hIcon.TextColor3 = Theme.Text
        hIcon.TextXAlignment = Enum.TextXAlignment.Left
        hIcon.Parent = innerHeader

        local hTitle = Instance.new("TextLabel")
        hTitle.Size = UDim2.new(1, -30, 0, 20)
        hTitle.Position = UDim2.new(0, 28, 0, 5)
        hTitle.BackgroundTransparency = 1
        hTitle.Text = titulo
        hTitle.TextColor3 = Theme.Text
        hTitle.TextSize = 15
        hTitle.Font = Enum.Font.GothamBlack
        hTitle.TextXAlignment = Enum.TextXAlignment.Left
        hTitle.Parent = innerHeader

        local hSub = Instance.new("TextLabel")
        hSub.Size = UDim2.new(1, -30, 0, 14)
        hSub.Position = UDim2.new(0, 28, 0, 26)
        hSub.BackgroundTransparency = 1
        hSub.Text = subtitulo
        hSub.TextColor3 = Theme.TextDim
        hSub.TextSize = 10
        hSub.Font = Enum.Font.Gotham
        hSub.TextXAlignment = Enum.TextXAlignment.Left
        hSub.Parent = innerHeader

        -- ScrollingFrame pros cards
        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(1, -20, 1, -75)
        scroll.Position = UDim2.new(0, 10, 0, 65)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 3
        scroll.ScrollBarImageColor3 = Theme.Gold
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.Parent = frame

        local grid = Instance.new("UIGridLayout")
        grid.CellSize = UDim2.new(0, 285, 0, 100)
        grid.CellPadding = UDim2.new(0, 8, 0, 8)
        grid.SortOrder = Enum.SortOrder.LayoutOrder
        grid.Parent = scroll

        grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            scroll.CanvasSize = UDim2.new(0, 0, 0, grid.AbsoluteContentSize.Y + 10)
        end)

        return scroll
    end

    -- Cria 3 abas
    local scrollScripts = criarConteudo("scripts", "SCRIPT LIST", "Selecione um script para executar")
    local scrollUtils = criarConteudo("utils", "UTILIDADES", "Ferramentas úteis")
    local scrollInfo = criarConteudo("info", "INFORMAÇÕES", "Sobre o PBL HUB")

    -- ═══ FUNÇÃO CRIAR CARD ═══
    local function criarCard(parent, nome, sub, icone, corIcone, tipo, acao, ordem)
        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(1, 0, 0, 100)
        Card.BackgroundColor3 = Theme.Card
        Card.BorderSizePixel = 0
        Card.LayoutOrder = ordem
        Card.Parent = parent
        corner(Card, 10)
        grad(Card, Theme.Card, Theme.CardGrad, 90)
        local cs = stroke(Card, Theme.Card, 1.5, 0.4)

        -- Ícone circular
        local iconCircle = Instance.new("Frame")
        iconCircle.Size = UDim2.new(0, 40, 0, 40)
        iconCircle.Position = UDim2.new(0, 12, 0, 12)
        iconCircle.BackgroundColor3 = corIcone
        iconCircle.BackgroundTransparency = 0.75
        iconCircle.BorderSizePixel = 0
        iconCircle.Parent = Card
        corner(iconCircle, 20)
        stroke(iconCircle, corIcone, 1.5, 0.3)

        local iconLbl = Instance.new("TextLabel")
        iconLbl.Size = UDim2.new(1, 0, 1, 0)
        iconLbl.BackgroundTransparency = 1
        iconLbl.Text = icone
        iconLbl.TextSize = 20
        iconLbl.Font = Enum.Font.GothamBold
        iconLbl.Parent = iconCircle

        -- Nome
        local nomeLbl = Instance.new("TextLabel")
        nomeLbl.Size = UDim2.new(1, -70, 0, 20)
        nomeLbl.Position = UDim2.new(0, 60, 0, 12)
        nomeLbl.BackgroundTransparency = 1
        nomeLbl.Text = nome
        nomeLbl.TextColor3 = Theme.Text
        nomeLbl.TextSize = 13
        nomeLbl.Font = Enum.Font.GothamBlack
        nomeLbl.TextXAlignment = Enum.TextXAlignment.Left
        nomeLbl.Parent = Card

        -- Sub
        local subLbl = Instance.new("TextLabel")
        subLbl.Size = UDim2.new(1, -70, 0, 14)
        subLbl.Position = UDim2.new(0, 60, 0, 34)
        subLbl.BackgroundTransparency = 1
        subLbl.Text = sub
        subLbl.TextColor3 = Theme.TextDim
        subLbl.TextSize = 9
        subLbl.Font = Enum.Font.Gotham
        subLbl.TextXAlignment = Enum.TextXAlignment.Left
        subLbl.Parent = Card

        -- Botão de ação (parte inferior)
        local actionBtn = Instance.new("TextButton")
        actionBtn.Size = UDim2.new(1, -24, 0, 28)
        actionBtn.Position = UDim2.new(0, 12, 1, -38)
        actionBtn.BackgroundColor3 = Theme.Sidebar
        actionBtn.Text = tipo == "toggle" and "ATIVAR" or "EXECUTE"
        actionBtn.TextColor3 = Theme.TextSoft
        actionBtn.TextSize = 11
        actionBtn.Font = Enum.Font.GothamBold
        actionBtn.BorderSizePixel = 0
        actionBtn.AutoButtonColor = false
        actionBtn.Parent = Card
        corner(actionBtn, 6)
        local abs = stroke(actionBtn, Theme.Card, 1, 0.3)

        local ativo = false

        actionBtn.MouseEnter:Connect(function()
            sHover()
            TweenSvc:Create(actionBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.CardHover}):Play()
            TweenSvc:Create(cs, TweenInfo.new(0.15), {Color = corIcone, Transparency = 0.1}):Play()
        end)
        actionBtn.MouseLeave:Connect(function()
            if not ativo then
                TweenSvc:Create(actionBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Sidebar}):Play()
                TweenSvc:Create(cs, TweenInfo.new(0.15), {Color = Theme.Card, Transparency = 0.4}):Play()
            end
        end)

        actionBtn.MouseButton1Click:Connect(function()
            if tipo == "toggle" then
                ativo = not ativo
                sToggle()
                if ativo then
                    actionBtn.Text = "DESATIVAR"
                    TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Success, TextColor3 = Color3.fromRGB(20, 25, 20)}):Play()
                    TweenSvc:Create(cs, TweenInfo.new(0.2), {Color = Theme.Success, Transparency = 0}):Play()
                    if acao then acao() end
                else
                    actionBtn.Text = "ATIVAR"
                    TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.TextSoft}):Play()
                    TweenSvc:Create(cs, TweenInfo.new(0.2), {Color = Theme.Card, Transparency = 0.4}):Play()
                end
            else
                sClick()
                if acao then
                    local ok = pcall(acao)
                    if not ok then sError() end
                end
                TweenSvc:Create(actionBtn, TweenInfo.new(0.1), {BackgroundColor3 = corIcone}):Play()
                task.wait(0.2)
                TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Sidebar}):Play()
            end
        end)

        return Card
    end

    -- ═══ CARDS DA ABA SCRIPTS ═══
    criarCard(scrollScripts, "MIRANDA AFK", "Farm AFK automático", "◉", Theme.Accent, "toggle", funcoes.miranda_afk, 1)
    criarCard(scrollScripts, "LENNON AFK", "Farm AFK automático", "◉", Theme.Accent, "toggle", funcoes.lennon_afk, 2)
    criarCard(scrollScripts, "MIRANDA STEAL", "Instalar scripts e shift", "◈", Color3.fromRGB(255, 200, 80), "exec", funcoes.miranda_steal, 3)
    criarCard(scrollScripts, "LENNON STEAL", "Instalar scripts e shift", "◈", Color3.fromRGB(255, 200, 80), "exec", funcoes.lennon_steal, 4)

    -- ═══ CARDS DA ABA UTILS ═══
    criarCard(scrollUtils, "REJOIN", "Reconectar no servidor", "↻", Theme.Accent, "exec", funcoes.rejoin, 1)
    criarCard(scrollUtils, "FULLBRIGHT", "Iluminar o mapa", "☀", Color3.fromRGB(255, 220, 100), "toggle", funcoes.fullbright, 2)

    -- ═══ ABA INFO ═══
    local infoFrame = Instance.new("Frame")
    infoFrame.Size = UDim2.new(1, 0, 0, 200)
    infoFrame.Position = UDim2.new(0, 0, 0, 0)
    infoFrame.BackgroundColor3 = Theme.Card
    infoFrame.BorderSizePixel = 0
    infoFrame.Parent = scrollInfo
    corner(infoFrame, 10)
    stroke(infoFrame, Theme.Gold, 1, 0.4)

    local infoLbl = Instance.new("TextLabel")
    infoLbl.Size = UDim2.new(1, -20, 1, -20)
    infoLbl.Position = UDim2.new(0, 10, 0, 10)
    infoLbl.BackgroundTransparency = 1
    infoLbl.Text = "PBL HUB " .. CONFIG.Versao .. "\n\n" ..
        "Desenvolvido com ❤\n" ..
        "Interface design profissional\n\n" ..
        "Usuário: " .. CONFIG.Nome .. "\n" ..
        "Data: " .. os.date("%d/%m/%Y")
    infoLbl.TextColor3 = Theme.TextSoft
    infoLbl.TextSize = 12
    infoLbl.Font = Enum.Font.Gotham
    infoLbl.TextXAlignment = Enum.TextXAlignment.Left
    infoLbl.TextYAlignment = Enum.TextYAlignment.Top
    infoLbl.Parent = infoFrame
end

-- ══════════ VERIFICAÇÃO DA KEY ══════════
local verificando = false
local function verificar()
    if verificando then return end
    verificando = true
    if kInput.Text == CONFIG.Key then
        sSuccess()
        kBtn.Text = "✓ CORRETA"
        task.wait(0.5)
        pcall(function() keyGui:Destroy() end)
        task.wait(0.2)
        local ok, err = pcall(criarPainel)
        if not ok then
            warn("[PBL] " .. tostring(err))
            notificar("Erro ao criar painel", Theme.Error)
        else
            notificar("Bem-vindo ao PBL HUB!", Theme.Success)
        end
        verificando = false
    else
        sError()
        kBtn.Text = "✕ KEY INVÁLIDA"
        kInput.Text = ""
        task.wait(1.2)
        kBtn.Text = "ACESSAR"
        verificando = false
    end
end

kBtn.MouseButton1Click:Connect(verificar)
kInput.FocusLost:Connect(function(enter)
    if enter then verificar() end
end)

print("[PBL HUB] Aguardando key... (key: " .. CONFIG.Key .. ")")
