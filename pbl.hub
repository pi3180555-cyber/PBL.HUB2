-- ══════════ NOTIFICAÇÃO ══════════
local function notificar(msg, cor)
    pcall(function()
        local old = CoreGui:FindFirstChild("PBL_PRO_Notif")
        if old then old:Destroy() end
        local g = Instance.new("ScreenGui")
        g.Name = "PBL_PRO_Notif"
        g.Parent = CoreGui
        g.IgnoreGuiInset = true
        g.DisplayOrder = 9999
        local f = Instance.new("Frame")
        f.Size = UDim2.new(0, 300, 0, 48)
        f.Position = UDim2.new(0.5, -150, 0, 25)
        f.BackgroundColor3 = Theme.Card
        f.BorderSizePixel = 0
        f.Parent = g
        corner(f, 10)
        stroke(f, cor, 1.5, 0.3)
        local l = Instance.new("TextLabel")
        l.Size = UDim2.new(1, -20, 1, 0)
        l.Position = UDim2.new(0, 15, 0, 0)
        l.BackgroundTransparency = 1
        l.Text = msg
        l.TextColor3 = Theme.Text
        l.TextSize = 12
        l.Font = Enum.Font.GothamMedium
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.Parent = f
        task.delay(3, function() if g then g:Destroy() end end)
    end)
end

-- ══════════ FUNÇÕES DOS SCRIPTS ══════════
local funcoes = {
    miranda_afk = function()
        notificar("Miranda AFK ativado", Theme.Success)
    end,
    lennon_afk = function()
        notificar("Lennon AFK ativado", Theme.Success)
    end,
    miranda_steal = function()
        local ok = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/miirandahub/loader/refs/heads/main/mirandaafk.lua"))()
        end)
        if ok then notificar("Miranda Steal carregado", Theme.Success)
        else notificar("Erro ao carregar", Theme.Error) end
    end,
    lennon_steal = function()
        local ok = pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/lennonxscripts/lennonhubv3/refs/heads/main/stealanegg.lua"))()
        end)
        if ok then notificar("Lennon Steal carregado", Theme.Success)
        else notificar("Erro ao carregar", Theme.Error) end
    end,
    rejoin = function()
        notificar("Reconectando...", Theme.Accent)
        task.wait(0.5)
        game:GetService("TeleportService"):Teleport(game.PlaceId, LP)
    end,
    fullbright = function()
        pcall(function()
            game:GetService("Lighting").Ambient = Color3.fromRGB(255,255,255)
            game:GetService("Lighting").Brightness = 2
        end)
        notificar("Fullbright ativado", Theme.Success)
    end
}

