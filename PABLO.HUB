    criarCard(scrollUtils, "FULLBRIGHT", "Iluminar o mapa", "☀", Color3.fromRGB(255, 220, 100), "exec", funcoes.fullbright, 4)
    criarCard(scrollUtils, "RESET", "Resetar personagem", "↺", Theme.Error, "exec", funcoes.reset, 5)
    criarCard(scrollUtils, "SPEED LEVE", "Velocidade 45-55", "»", Theme.Success, "exec", funcoes.speed, 6)
    criarCard(scrollUtils, "NOCLIP", "Atravessa paredes", "◌", Theme.Warning, "exec", funcoes.noclip, 7)
    criarCard(scrollUtils, "HIDE PLAYERS", "Esconde jogadores", "◐", Theme.Accent, "exec", funcoes.hide, 8)
    criarCard(scrollUtils, "ANTI-AFK", "Evita kick", "☾", Theme.Error, "exec", funcoes.antiafk, 9)
    criarCard(scrollUtils, "FPS BOOST", "Melhora performance", "⚡", Theme.Warning, "exec", funcoes.fpsboost, 10)
    criarCard(scrollUtils, "USER ID", "Copiar seu ID", "🆔", Theme.Accent, "exec", funcoes.userid, 11)
    criarCard(scrollUtils, "VER PING", "Latência atual", "📡", Theme.Success, "exec", funcoes.ping, 12)
    criarCard(scrollUtils, "FLY 5s", "Voar por 5 segundos", "✈", Theme.Accent, "exec", funcoes.fly, 13)
    criarCard(scrollUtils, "FECHAR TUDO", "Fecha interfaces", "✕", Theme.Error, "exec", funcoes.fechartudo, 14)

    -- ══════════ CARDS DA ABA COMBAT ══════════
    criarCard(scrollCombat, "ANTI-VOID", "Salva se cair do mapa", "🛡", Theme.Success, "exec", funcoes.antivoid, 1)
    criarCard(scrollCombat, "ADD ALL FRIENDS", "Segue todos", "👥", Color3.fromRGB(88, 101, 242), "exec", funcoes.social, 2)

    -- ══════════ ABA INFO ══════════
    local infoFrame = Instance.new("Frame")
    infoFrame.Size = UDim2.new(1, 0, 0, 220)
    infoFrame.Position = UDim2.new(0, 0, 0, 0)
    infoFrame.BackgroundColor3 = Theme.Card
    infoFrame.BorderSizePixel = 0
    infoFrame.Parent = scrollInfo
    corner(infoFrame, 10)
    stroke(infoFrame, Theme.Gold, 1, 0.4)

    local infoLbl = Instance.new("TextLabel")
    infoLbl.Size = UDim2.new(1, -20, 1, -20)
    infoLbl.Position = UDim2.new(0, 10, 0, 10)
    infoLbl.BackgroundTransparency = 1
    infoLbl.Text = "PBL HUB " .. CONFIG.Versao .. "\n\n" ..
        "Desenvolvido com ❤\n" ..
        "Interface profissional\n\n" ..
        "Usuário: " .. CONFIG.Nome .. "\n" ..
        "Data: " .. os.date("%d/%m/%Y") .. "\n" ..
        "Scripts executados: " .. contadorScripts
    infoLbl.TextColor3 = Theme.TextSoft
    infoLbl.TextSize = 12
    infoLbl.Font = Enum.Font.Gotham
    infoLbl.TextXAlignment = Enum.TextXAlignment.Left
    infoLbl.TextYAlignment = Enum.TextYAlignment.Top
    infoLbl.Parent = infoFrame

    -- Ativa aba SCRIPTS por padrão
    for k, v in pairs(conteudos) do
        v.Visible = (k == "scripts")
    end
end

