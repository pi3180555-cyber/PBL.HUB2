end)
kBtn.MouseLeave:Connect(function()
    TweenSvc:Create(kBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Gold}):Play()
end)

-- ══════════ PAINEL PRINCIPAL ══════════
local function criarPainel()
    local gui = Instance.new("ScreenGui")
    gui.Name = "PBL_PRO_Main"
    gui.Parent = CoreGui
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 400

    local Main = Instance.new("Frame")
    Main.Size = UDim2.new(0, 760, 0, 480)
    Main.Position = UDim2.new(0.5, -380, 0.5, -240)
    Main.BackgroundColor3 = Theme.Bg
    Main.BorderSizePixel = 0
    Main.Active = true
    Main.Draggable = true
    Main.Parent = gui
    corner(Main, 14)
    grad(Main, Theme.BgGrad, Theme.Bg, 90)
    stroke(Main, Theme.Gold, 1.5, 0.3)

    -- HEADER
    local Header = Instance.new("Frame")
    Header.Size = UDim2.new(1, 0, 0, 60)
    Header.BackgroundColor3 = Theme.Bg
    Header.BackgroundTransparency = 0.3
    Header.BorderSizePixel = 0
    Header.Parent = Main
    corner(Header, 14)

    local HeaderLine = Instance.new("Frame")
    HeaderLine.Size = UDim2.new(1, 0, 0, 1)
    HeaderLine.Position = UDim2.new(0, 0, 1, -1)
    HeaderLine.BackgroundColor3 = Theme.Gold
    HeaderLine.BackgroundTransparency = 0.6
    HeaderLine.BorderSizePixel = 0
    HeaderLine.Parent = Header

    local LogoBox = Instance.new("Frame")
    LogoBox.Size = UDim2.new(0, 38, 0, 38)
    LogoBox.Position = UDim2.new(0, 15, 0, 11)
    LogoBox.BackgroundColor3 = Theme.Card
    LogoBox.BorderSizePixel = 0
    LogoBox.Parent = Header
    corner(LogoBox, 10)
    stroke(LogoBox, Theme.Gold, 1.5, 0.2)

    local LogoText = Instance.new("TextLabel")
    LogoText.Size = UDim2.new(1, 0, 1, 0)
    LogoText.BackgroundTransparency = 1
    LogoText.Text = "PBL"
    LogoText.TextColor3 = Theme.Gold
    LogoText.TextSize = 13
    LogoText.Font = Enum.Font.GothamBlack
    LogoText.Parent = LogoBox

    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(0.5, 0, 0, 22)
    Title.Position = UDim2.new(0, 62, 0, 12)
    Title.BackgroundTransparency = 1
    Title.Text = "PBL HUB"
    Title.TextColor3 = Theme.Text
    Title.TextSize = 17
    Title.Font = Enum.Font.GothamBlack
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = Header

    local SubTitle = Instance.new("TextLabel")
    SubTitle.Size = UDim2.new(0.5, 0, 0, 16)
    SubTitle.Position = UDim2.new(0, 62, 0, 34)
    SubTitle.BackgroundTransparency = 1
    SubTitle.Text = CONFIG.Versao .. "  |  Bem-vindo, " .. CONFIG.Nome
    SubTitle.TextColor3 = Theme.TextDim
    SubTitle.TextSize = 10
    SubTitle.Font = Enum.Font.Gotham
    SubTitle.TextXAlignment = Enum.TextXAlignment.Left
    SubTitle.Parent = Header

    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 28, 0, 28)
    CloseBtn.Position = UDim2.new(1, -40, 0, 16)
    CloseBtn.BackgroundColor3 = Color3.fromRGB(220, 60, 60)
    CloseBtn.Text = "×"
    CloseBtn.TextColor3 = Theme.Text
    CloseBtn.TextSize = 16
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.BorderSizePixel = 0
    CloseBtn.AutoButtonColor = false
    CloseBtn.Parent = Header
    corner(CloseBtn, 8)
    CloseBtn.MouseEnter:Connect(function() sHover() end)
    CloseBtn.MouseButton1Click:Connect(function()
        sClick()
        gui:Destroy()
    end)

    local MinBtn = Instance.new("TextButton")
    MinBtn.Size = UDim2.new(0, 28, 0, 28)
    MinBtn.Position = UDim2.new(1, -74, 0, 16)
    MinBtn.BackgroundColor3 = Color3.fromRGB(230, 180, 60)
    MinBtn.Text = "−"
    MinBtn.TextColor3 = Color3.fromRGB(25, 25, 30)
    MinBtn.TextSize = 16
    MinBtn.Font = Enum.Font.GothamBold
    MinBtn.BorderSizePixel = 0
    MinBtn.AutoButtonColor = false
    MinBtn.Parent = Header
    corner(MinBtn, 8)
    MinBtn.MouseEnter:Connect(function() sHover() end)
    MinBtn.MouseButton1Click:Connect(function()
        sClick()
        Main.Visible = false
        local reopenBtn = Instance.new("TextButton")
        reopenBtn.Size = UDim2.new(0, 60, 0, 60)
        reopenBtn.Position = UDim2.new(0, 20, 0.5, -30)
        reopenBtn.BackgroundColor3 = Theme.Gold
        reopenBtn.Text = "PBL"
        reopenBtn.TextColor3 = Color3.fromRGB(25, 25, 30)
        reopenBtn.TextSize = 14
        reopenBtn.Font = Enum.Font.GothamBlack
        reopenBtn.BorderSizePixel = 0
        reopenBtn.Parent = gui
        corner(reopenBtn, 30)
        stroke(reopenBtn, Theme.Gold, 2, 0)
        reopenBtn.MouseEnter:Connect(function() sHover() end)
        reopenBtn.MouseButton1Click:Connect(function()
            sClick()
            Main.Visible = true
            reopenBtn:Destroy()
        end)
    end)

    -- SIDEBAR
    local Sidebar = Instance.new("Frame")
    Sidebar.Size = UDim2.new(0, 100, 1, -60)
    Sidebar.Position = UDim2.new(0, 0, 0, 60)
    Sidebar.BackgroundColor3 = Theme.Sidebar
    Sidebar.BackgroundTransparency = 0.5
    Sidebar.BorderSizePixel = 0
    Sidebar.Parent = Main

    local SidebarLine = Instance.new("Frame")
    SidebarLine.Size = UDim2.new(0, 1, 1, 0)
    SidebarLine.Position = UDim2.new(1, -1, 0, 0)
    SidebarLine.BackgroundColor3 = Theme.Card
    SidebarLine.BackgroundTransparency = 0.5
    SidebarLine.BorderSizePixel = 0
    SidebarLine.Parent = Sidebar

    local SidebarList = Instance.new("UIListLayout")
    SidebarList.Padding = UDim.new(0, 4)
    SidebarList.HorizontalAlignment = Enum.HorizontalAlignment.Center
    SidebarList.Parent = Sidebar

    local SidebarPad = Instance.new("UIPadding")
    SidebarPad.PaddingTop = UDim.new(0, 15)
    SidebarPad.Parent = Sidebar

    local tabsAtivas = {}
    local conteudos = {}

    local function criarTab(nome, icone, id)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 82, 0, 58)
        btn.BackgroundColor3 = Theme.Sidebar
        btn.BackgroundTransparency = 1
        btn.Text = ""
        btn.BorderSizePixel = 0
        btn.AutoButtonColor = false
        btn.Parent = Sidebar
        corner(btn, 8)

        local iconeLbl = Instance.new("TextLabel")
        iconeLbl.Size = UDim2.new(1, 0, 0, 24)
        iconeLbl.Position = UDim2.new(0, 0, 0, 8)
        iconeLbl.BackgroundTransparency = 1
        iconeLbl.Text = icone
        iconeLbl.TextSize = 20
        iconeLbl.Font = Enum.Font.GothamBold
        iconeLbl.TextColor3 = Theme.TextDim
        iconeLbl.Parent = btn

        local nomeLbl = Instance.new("TextLabel")
        nomeLbl.Size = UDim2.new(1, 0, 0, 14)
        nomeLbl.Position = UDim2.new(0, 0, 0, 36)
        nomeLbl.BackgroundTransparency = 1
        nomeLbl.Text = nome
        nomeLbl.TextSize = 9
        nomeLbl.Font = Enum.Font.GothamBold
        nomeLbl.TextColor3 = Theme.TextDim
        nomeLbl.Parent = btn

        btn.MouseEnter:Connect(function()
            if tabsAtivas[id] then return end
            sHover()
            TweenSvc:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0.7}):Play()
        end)
        btn.MouseLeave:Connect(function()
            if tabsAtivas[id] then return end
            TweenSvc:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
        end)
        btn.MouseButton1Click:Connect(function()
            sClick()
            for k, v in pairs(tabsAtivas) do
                local b = v.btn
                local i = v.icone
                local n = v.nome
                tabsAtivas[k] = nil
                TweenSvc:Create(b, TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
                TweenSvc:Create(i, TweenInfo.new(0.15), {TextColor3 = Theme.TextDim}):Play()
                TweenSvc:Create(n, TweenInfo.new(0.15), {TextColor3 = Theme.TextDim}):Play()
            end
            tabsAtivas[id] = {btn = btn, icone = iconeLbl, nome = nomeLbl}
            TweenSvc:Create(btn, TweenInfo.new(0.15), {BackgroundTransparency = 0, BackgroundColor3 = Theme.SidebarActive}):Play()
            TweenSvc:Create(iconeLbl, TweenInfo.new(0.15), {TextColor3 = Theme.Text}):Play()
            TweenSvc:Create(nomeLbl, TweenInfo.new(0.15), {TextColor3 = Theme.Text}):Play()
            for k, f in pairs(conteudos) do
                f.Visible = (k == id)
            end
        end)
        return btn
    end

    criarTab("SCRIPTS", "📜", "scripts")
    criarTab("UTILS", "🔧", "utils")
    criarTab("COMBAT", "⚔", "combat")
    criarTab("INFO", "ℹ", "info")

    tabsAtivas["scripts"] = nil

    -- ÁREA DE CONTEÚDO
    local Content = Instance.new("Frame")
    Content.Size = UDim2.new(1, -100, 1, -60)
    Content.Position = UDim2.new(0, 100, 0, 60)
    Content.BackgroundTransparency = 1
    Content.Parent = Main

    local function criarConteudo(id, titulo, subtitulo)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 1, 0)
        frame.BackgroundTransparency = 1
        frame.Visible = (id == "scripts")
        frame.Parent = Content
        conteudos[id] = frame

        local innerHeader = Instance.new("Frame")
        innerHeader.Size = UDim2.new(1, -30, 0, 45)
        innerHeader.Position = UDim2.new(0, 15, 0, 10)
        innerHeader.BackgroundTransparency = 1
        innerHeader.Parent = frame

        local hIcon = Instance.new("TextLabel")
        hIcon.Size = UDim2.new(0, 20, 0, 20)
        hIcon.Position = UDim2.new(0, 0, 0, 5)
        hIcon.BackgroundTransparency = 1
        hIcon.Text = "☰"
        hIcon.TextSize = 18
        hIcon.Font = Enum.Font.GothamBold
        hIcon.TextColor3 = Theme.Text
        hIcon.TextXAlignment = Enum.TextXAlignment.Left
        hIcon.Parent = innerHeader

        local hTitle = Instance.new("TextLabel")
        hTitle.Size = UDim2.new(1, -30, 0, 20)
        hTitle.Position = UDim2.new(0, 28, 0, 5)
        hTitle.BackgroundTransparency = 1
        hTitle.Text = titulo
        hTitle.TextColor3 = Theme.Text
        hTitle.TextSize = 15
        hTitle.Font = Enum.Font.GothamBlack
        hTitle.TextXAlignment = Enum.TextXAlignment.Left
        hTitle.Parent = innerHeader

        local hSub = Instance.new("TextLabel")
        hSub.Size = UDim2.new(1, -30, 0, 14)
        hSub.Position = UDim2.new(0, 28, 0, 26)
        hSub.BackgroundTransparency = 1
        hSub.Text = subtitulo
        hSub.TextColor3 = Theme.TextDim
        hSub.TextSize = 10
        hSub.Font = Enum.Font.Gotham
        hSub.TextXAlignment = Enum.TextXAlignment.Left
        hSub.Parent = innerHeader

        local scroll = Instance.new("ScrollingFrame")
        scroll.Size = UDim2.new(1, -20, 1, -75)
        scroll.Position = UDim2.new(0, 10, 0, 65)
        scroll.BackgroundTransparency = 1
        scroll.BorderSizePixel = 0
        scroll.ScrollBarThickness = 3
        scroll.ScrollBarImageColor3 = Theme.Gold
        scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
        scroll.Parent = frame

        local grid = Instance.new("UIGridLayout")
        grid.CellSize = UDim2.new(0, 300, 0, 105)
        grid.CellPadding = UDim2.new(0, 8, 0, 8)
        grid.SortOrder = Enum.SortOrder.LayoutOrder
        grid.Parent = scroll

        grid:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            scroll.CanvasSize = UDim2.new(0, 0, 0, grid.AbsoluteContentSize.Y + 10)
        end)
        return scroll
    end

    local scrollScripts = criarConteudo("scripts", "SCRIPT LIST", "Selecione um script para executar")
    local scrollUtils = criarConteudo("utils", "UTILIDADES", "Ferramentas úteis")
    local scrollCombat = criarConteudo("combat", "COMBATE", "Funções de combate")
    local scrollInfo = criarConteudo("info", "INFORMAÇÕES", "Sobre o PBL HUB")    -- ══════════ FUNÇÃO CRIAR CARD ══════════
    local function criarCard(parent, nome, sub, icone, corIcone, tipo, acao, ordem)
        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(1, 0, 0, 105)
        Card.BackgroundColor3 = Theme.Card
        Card.BorderSizePixel = 0
        Card.LayoutOrder = ordem
        Card.Parent = parent
        corner(Card, 10)
        grad(Card, Theme.Card, Theme.CardGrad, 90)
        local cs = stroke(Card, Theme.Card, 1.5, 0.4)

        local iconCircle = Instance.new("Frame")
        iconCircle.Size = UDim2.new(0, 40, 0, 40)
        iconCircle.Position = UDim2.new(0, 12, 0, 12)
        iconCircle.BackgroundColor3 = corIcone
        iconCircle.BackgroundTransparency = 0.75
        iconCircle.BorderSizePixel = 0
        iconCircle.Parent = Card
        corner(iconCircle, 20)
        stroke(iconCircle, corIcone, 1.5, 0.3)

        local iconLbl = Instance.new("TextLabel")
        iconLbl.Size = UDim2.new(1, 0, 1, 0)
        iconLbl.BackgroundTransparency = 1
        iconLbl.Text = icone
        iconLbl.TextSize = 20
        iconLbl.Font = Enum.Font.GothamBold
        iconLbl.TextColor3 = corIcone
        iconLbl.Parent = iconCircle

        local nomeLbl = Instance.new("TextLabel")
        nomeLbl.Size = UDim2.new(1, -70, 0, 20)
        nomeLbl.Position = UDim2.new(0, 60, 0, 12)
        nomeLbl.BackgroundTransparency = 1
        nomeLbl.Text = nome
        nomeLbl.TextColor3 = Theme.Text
        nomeLbl.TextSize = 12
        nomeLbl.Font = Enum.Font.GothamBlack
        nomeLbl.TextXAlignment = Enum.TextXAlignment.Left
        nomeLbl.Parent = Card

        local subLbl = Instance.new("TextLabel")
        subLbl.Size = UDim2.new(1, -70, 0, 14)
        subLbl.Position = UDim2.new(0, 60, 0, 34)
        subLbl.BackgroundTransparency = 1
        subLbl.Text = sub
        subLbl.TextColor3 = Theme.TextDim
        subLbl.TextSize = 9
        subLbl.Font = Enum.Font.Gotham
        subLbl.TextXAlignment = Enum.TextXAlignment.Left
        subLbl.Parent = Card

        local actionBtn = Instance.new("TextButton")
        actionBtn.Size = UDim2.new(1, -24, 0, 30)
        actionBtn.Position = UDim2.new(0, 12, 1, -42)
        actionBtn.BackgroundColor3 = Theme.Sidebar
        actionBtn.Text = (tipo == "toggle") and "ATIVAR" or "EXECUTE"
        actionBtn.TextColor3 = Theme.TextSoft
        actionBtn.TextSize = 11
        actionBtn.Font = Enum.Font.GothamBold
        actionBtn.BorderSizePixel = 0
        actionBtn.AutoButtonColor = false
        actionBtn.Parent = Card
        corner(actionBtn, 6)
        local abs = stroke(actionBtn, Theme.Card, 1, 0.3)

        local ativo = false

        actionBtn.MouseEnter:Connect(function()
            sHover()
            TweenSvc:Create(actionBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.CardHover}):Play()
            TweenSvc:Create(cs, TweenInfo.new(0.15), {Color = corIcone, Transparency = 0.1}):Play()
        end)
        actionBtn.MouseLeave:Connect(function()
            if not ativo then
                TweenSvc:Create(actionBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Sidebar}):Play()
                TweenSvc:Create(cs, TweenInfo.new(0.15), {Color = Theme.Card, Transparency = 0.4}):Play()
            end
        end)

        actionBtn.MouseButton1Click:Connect(function()
            if tipo == "toggle" then
                ativo = not ativo
                sToggle()
                if ativo then
                    actionBtn.Text = "DESATIVAR"
                    TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Success, TextColor3 = Color3.fromRGB(20, 25, 20)}):Play()
                    TweenSvc:Create(cs, TweenInfo.new(0.2), {Color = Theme.Success, Transparency = 0}):Play()
                    if acao then acao() end
                else
                    actionBtn.Text = "ATIVAR"
                    TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.TextSoft}):Play()
                    TweenSvc:Create(cs, TweenInfo.new(0.2), {Color = Theme.Card, Transparency = 0.4}):Play()
                end
            else
                sClick()
                if acao then
                    contadorScripts = contadorScripts + 1
                    local ok = pcall(acao)
                    if not ok then sError() end
                end
                TweenSvc:Create(actionBtn, TweenInfo.new(0.1), {BackgroundColor3 = corIcone}):Play()
                task.wait(0.2)
                TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Sidebar}):Play()
            end
        end)

        return Card
    end

    -- ══════════ CARDS DA ABA SCRIPTS ══════════
    criarCard(scrollScripts, "CHILLI AURA", "Aura visual", "◉", Theme.Chilli, "exec", funcoes.chilli, 1)
    criarCard(scrollScripts, "MIRANDA AFK", "Farm AFK automático", "◉", Theme.Miranda, "exec", funcoes.miranda_afk_script, 2)
    criarCard(scrollScripts, "LENNON FARM", "Farm principal", "◉", Theme.Lennon, "exec", funcoes.lennon_farm, 3)
    criarCard(scrollScripts, "MIRANDA STEAL", "Auto steal eggs", "◈", Color3.fromRGB(90, 180, 255), "exec", funcoes.miranda_steal, 4)
    criarCard(scrollScripts, "LENNON STEAL", "Farm melhorado", "◈", Color3.fromRGB(200, 100, 255), "exec", funcoes.lennon_steal, 5)

    -- ══════════ CARDS DA ABA UTILS ══════════
    criarCard(scrollUtils, "REJOIN", "Reconectar no servidor", "↻", Theme.Accent, "exec", funcoes.rejoin, 1)
    criarCard(scrollUtils, "SERVER HOP", "Trocar de servidor", "⇄", Theme.Accent, "exec", funcoes.hop, 2)
    criarCard(scrollUtils, "DISCORD", "Abrir nosso Discord", "💬", Color3.fromRGB(88, 101, 242), "exec", funcoes.discord, 3)
    criarCard(scrollUtils, "FULLBRIGHT", "Iluminar o mapa", "☀", Color3.fromRGB(255, 220, 100), "exec", funcoes.fullbright, 4)
    criarCard(scrollUtils, "RESET", "Resetar personagem", "↺", Theme.Error, "exec", funcoes.reset, 5)
    criarCard(scrollUtils, "SPEED LEVE", "Velocidade 45-55", "»", Theme.Success, "exec", funcoes.speed, 6)
    criarCard(scrollUtils, "NOCLIP", "Atravessa paredes", "◌", Theme.Warning, "exec", funcoes.noclip, 7)
    criarCard(scrollUtils, "HIDE PLAYERS", "Esconde jogadores", "◐", Theme.Accent, "exec", funcoes.hide, 8)
    criarCard(scrollUtils, "ANTI-AFK", "Evita kick", "☾", Theme.Error, "exec", funcoes.antiafk, 9)
    criarCard(scrollUtils, "FPS BOOST", "Melhora performance", "⚡", Theme.Warning, "exec", funcoes.fpsboost, 10)
    criarCard(scrollUtils, "USER ID", "Copiar seu ID", "🆔", Theme.Accent, "exec", funcoes.userid, 11)
    criarCard(scrollUtils, "VER PING", "Latência atual", "📡", Theme.Success, "exec", funcoes.ping, 12)
    criarCard(scrollUtils, "FLY 5s", "Voar por 5 segundos", "✈", Theme.Accent, "exec", funcoes.fly, 13)
    criarCard(scrollUtils, "FECHAR TUDO", "Fecha interfaces", "✕", Theme.Error, "exec", funcoes.fechartudo, 14)

    -- ══════════ CARDS DA ABA COMBAT ══════════
    criarCard(scrollCombat, "ANTI-VOID", "Salva se cair do mapa", "🛡", Theme.Success, "exec", funcoes.antivoid, 1)
    criarCard(scrollCombat, "ADD ALL FRIENDS", "Segue todos", "👥", Color3.fromRGB(88, 101, 242), "exec", funcoes.social, 2)

    -- ══════════ ABA INFO ══════════
    local infoFrame = Instance.new("Frame")
    infoFrame.Size = UDim2.new(1, 0, 0, 220)
    infoFrame.Position = UDim2.new(0, 0, 0, 0)
    infoFrame.BackgroundColor3 = Theme.Card
    infoFrame.BorderSizePixel = 0
    infoFrame.Parent = scrollInfo
    corner(infoFrame, 10)
    stroke(infoFrame, Theme.Gold, 1, 0.4)

    local infoLbl = Instance.new("TextLabel")
    infoLbl.Size = UDim2.new(1, -20, 1, -20)
    infoLbl.Position = UDim2.new(0, 10, 0, 10)
    infoLbl.BackgroundTransparency = 1
    infoLbl.Text = "PBL HUB " .. CONFIG.Versao .. "\n\n" ..
        "Desenvolvido com ❤\n" ..
        "Interface profissional\n\n" ..
        "Usuário: " .. CONFIG.Nome .. "\n" ..
        "Data: " .. os.date("%d/%m/%Y") .. "\n" ..
        "Scripts executados: " .. contadorScripts
    infoLbl.TextColor3 = Theme.TextSoft
    infoLbl.TextSize = 12
    infoLbl.Font = Enum.Font.Gotham
    infoLbl.TextXAlignment = Enum.TextXAlignment.Left
    infoLbl.TextYAlignment = Enum.TextYAlignment.Top
    infoLbl.Parent = infoFrame

    -- Ativa aba SCRIPTS por padrão
    for k, v in pairs(conteudos) do
        v.Visible = (k == "scripts")
    end

    -- Animação do avatar com pulse
    task.spawn(function()
        while gui.Parent do
            task.wait(0.5)
        end
    end)
end

-- ══════════ VERIFICAÇÃO DA KEY ══════════
local verificando = false
local function verificar()
    if verificando then return end
    verificando = true
    if kInput.Text == CONFIG.Key then
        sSuccess()
        kBtn.Text = "✓ CORRETA"
        task.wait(0.5)
        pcall(function() keyGui:Destroy() end)
        task.wait(0.2)
        local ok, err = pcall(criarPainel)
        if not ok then
            warn("[PBL] " .. tostring(err))
            notificar("Erro ao criar painel", Theme.Error)
        else
            notificar("Bem-vindo ao PBL HUB!", Theme.Success)
        end
        verificando = false
    else
        sError()
        kBtn.Text = "✕ KEY INVÁLIDA"
        kInput.Text = ""
        task.wait(1.2)
        kBtn.Text = "ACESSAR"
        verificando = false
    end
end

kBtn.MouseButton1Click:Connect(verificar)
kInput.FocusLost:Connect(function(enter)
    if enter then verificar() end
end)

print("[PBL HUB] Aguardando key... (key: " .. CONFIG.Key .. ")")    -- ══════════ FUNÇÃO CRIAR CARD ══════════
    local function criarCard(parent, nome, sub, icone, corIcone, tipo, acao, ordem)
        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(1, 0, 0, 105)
        Card.BackgroundColor3 = Theme.Card
        Card.BorderSizePixel = 0
        Card.LayoutOrder = ordem
        Card.Parent = parent
        corner(Card, 10)
        grad(Card, Theme.Card, Theme.CardGrad, 90)
        local cs = stroke(Card, Theme.Card, 1.5, 0.4)

        local iconCircle = Instance.new("Frame")
        iconCircle.Size = UDim2.new(0, 40, 0, 40)
        iconCircle.Position = UDim2.new(0, 12, 0, 12)
        iconCircle.BackgroundColor3 = corIcone
        iconCircle.BackgroundTransparency = 0.75
        iconCircle.BorderSizePixel = 0
        iconCircle.Parent = Card
        corner(iconCircle, 20)
        stroke(iconCircle, corIcone, 1.5, 0.3)

        local iconLbl = Instance.new("TextLabel")
        iconLbl.Size = UDim2.new(1, 0, 1, 0)
        iconLbl.BackgroundTransparency = 1
        iconLbl.Text = icone
        iconLbl.TextSize = 20
        iconLbl.Font = Enum.Font.GothamBold
        iconLbl.TextColor3 = corIcone
        iconLbl.Parent = iconCircle

        local nomeLbl = Instance.new("TextLabel")
        nomeLbl.Size = UDim2.new(1, -70, 0, 20)
        nomeLbl.Position = UDim2.new(0, 60, 0, 12)
        nomeLbl.BackgroundTransparency = 1
        nomeLbl.Text = nome
        nomeLbl.TextColor3 = Theme.Text
        nomeLbl.TextSize = 12
        nomeLbl.Font = Enum.Font.GothamBlack
        nomeLbl.TextXAlignment = Enum.TextXAlignment.Left
        nomeLbl.Parent = Card

        local subLbl = Instance.new("TextLabel")
        subLbl.Size = UDim2.new(1, -70, 0, 14)
        subLbl.Position = UDim2.new(0, 60, 0, 34)
        subLbl.BackgroundTransparency = 1
        subLbl.Text = sub
        subLbl.TextColor3 = Theme.TextDim
        subLbl.TextSize = 9
        subLbl.Font = Enum.Font.Gotham
        subLbl.TextXAlignment = Enum.TextXAlignment.Left
        subLbl.Parent = Card

        local actionBtn = Instance.new("TextButton")
        actionBtn.Size = UDim2.new(1, -24, 0, 30)
        actionBtn.Position = UDim2.new(0, 12, 1, -42)
        actionBtn.BackgroundColor3 = Theme.Sidebar
        actionBtn.Text = (tipo == "toggle") and "ATIVAR" or "EXECUTE"
        actionBtn.TextColor3 = Theme.TextSoft
        actionBtn.TextSize = 11
        actionBtn.Font = Enum.Font.GothamBold
        actionBtn.BorderSizePixel = 0
        actionBtn.AutoButtonColor = false
        actionBtn.Parent = Card
        corner(actionBtn, 6)
        local abs = stroke(actionBtn, Theme.Card, 1, 0.3)

        local ativo = false

        actionBtn.MouseEnter:Connect(function()
            sHover()
            TweenSvc:Create(actionBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.CardHover}):Play()
            TweenSvc:Create(cs, TweenInfo.new(0.15), {Color = corIcone, Transparency = 0.1}):Play()
        end)
        actionBtn.MouseLeave:Connect(function()
            if not ativo then
                TweenSvc:Create(actionBtn, TweenInfo.new(0.15), {BackgroundColor3 = Theme.Sidebar}):Play()
                TweenSvc:Create(cs, TweenInfo.new(0.15), {Color = Theme.Card, Transparency = 0.4}):Play()
            end
        end)

        actionBtn.MouseButton1Click:Connect(function()
            if tipo == "toggle" then
                ativo = not ativo
                sToggle()
                if ativo then
                    actionBtn.Text = "DESATIVAR"
                    TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Success, TextColor3 = Color3.fromRGB(20, 25, 20)}):Play()
                    TweenSvc:Create(cs, TweenInfo.new(0.2), {Color = Theme.Success, Transparency = 0}):Play()
                    if acao then acao() end
                else
                    actionBtn.Text = "ATIVAR"
                    TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Sidebar, TextColor3 = Theme.TextSoft}):Play()
                    TweenSvc:Create(cs, TweenInfo.new(0.2), {Color = Theme.Card, Transparency = 0.4}):Play()
                end
            else
                sClick()
                if acao then
                    contadorScripts = contadorScripts + 1
                    local ok = pcall(acao)
                    if not ok then sError() end
                end
                TweenSvc:Create(actionBtn, TweenInfo.new(0.1), {BackgroundColor3 = corIcone}):Play()
                task.wait(0.2)
                TweenSvc:Create(actionBtn, TweenInfo.new(0.2), {BackgroundColor3 = Theme.Sidebar}):Play()
            end
        end)

        return Card
    end

    -- ══════════ CARDS DA ABA SCRIPTS ══════════
    criarCard(scrollScripts, "CHILLI AURA", "Aura visual", "◉", Theme.Chilli, "exec", funcoes.chilli, 1)
    criarCard(scrollScripts, "MIRANDA AFK", "Farm AFK automático", "◉", Theme.Miranda, "exec", funcoes.miranda_afk_script, 2)
    criarCard(scrollScripts, "LENNON FARM", "Farm principal", "◉", Theme.Lennon, "exec", funcoes.lennon_farm, 3)
    criarCard(scrollScripts, "MIRANDA STEAL", "Auto steal eggs", "◈", Color3.fromRGB(90, 180, 255), "exec", funcoes.miranda_steal, 4)
    criarCard(scrollScripts, "LENNON STEAL", "Farm melhorado", "◈", Color3.fromRGB(200, 100, 255), "exec", funcoes.lennon_steal, 5)

    -- ══════════ CARDS DA ABA UTILS ══════════
    criarCard(scrollUtils, "REJOIN", "Reconectar no servidor", "↻", Theme.Accent, "exec", funcoes.rejoin, 1)
    criarCard(scrollUtils, "SERVER HOP", "Trocar de servidor", "⇄", Theme.Accent, "exec", funcoes.hop, 2)
