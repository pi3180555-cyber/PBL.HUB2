-- VERIFICAÇÃO
local verif = false
local function verificar()
    if verif then return end
    verif = true
    if kIn.Text == CONFIG.Key then
        sSuc()
        kBtn.Text = "✓ CORRETA"
        task.wait(0.5)
        pcall(function() keyGui:Destroy() end)
        task.wait(0.2)
        local ok = pcall(criarPainel)
        if ok then notificar("Bem-vindo ao PBL HUB!",T.Sc) else notificar("Erro ao criar painel",T.Er) end
        verif = false
    else
        sErr()
        kBtn.Text = "✕ INVÁLIDA"
        kIn.Text = ""
        task.wait(1.2)
        kBtn.Text = "ACESSAR"
        verif = false
    end
end

kBtn.MouseButton1Click:Connect(verificar)
kIn.FocusLost:Connect(function(e) if e then verificar() end end)

print("[PBL HUB] Aguardando key...")
