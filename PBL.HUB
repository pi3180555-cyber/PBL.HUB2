-- PAINEL
local function criarPainel()
    local gui = Instance.new("ScreenGui"); gui.Name = "PBL_Main"; gui.Parent = CoreGui; gui.IgnoreGuiInset = true; gui.DisplayOrder = 400
    
    local Main = Instance.new("Frame"); Main.Size = UDim2.new(0,760,0,480); Main.Position = UDim2.new(0.5,-380,0.5,-240); Main.BackgroundColor3 = T.Bg; Main.BorderSizePixel = 0; Main.Active = true; Main.Draggable = true; Main.Parent = gui
    cor(Main,14); grd(Main,T.Bg2,T.Bg,90); str(Main,T.Gd,1.5,0.3)
    
    -- HEADER
    local H = Instance.new("Frame"); H.Size = UDim2.new(1,0,0,60); H.BackgroundColor3 = T.Bg; H.BackgroundTransparency = 0.3; H.BorderSizePixel = 0; H.Parent = Main; cor(H,14)
    local HL = Instance.new("Frame"); HL.Size = UDim2.new(1,0,0,1); HL.Position = UDim2.new(0,0,1,-1); HL.BackgroundColor3 = T.Gd; HL.BackgroundTransparency = 0.6; HL.BorderSizePixel = 0; HL.Parent = H
    
    local LB = Instance.new("Frame"); LB.Size = UDim2.new(0,38,0,38); LB.Position = UDim2.new(0,15,0,11); LB.BackgroundColor3 = T.Cd; LB.BorderSizePixel = 0; LB.Parent = H
    cor(LB,10); str(LB,T.Gd,1.5,0.2)
    local LT = Instance.new("TextLabel"); LT.Size = UDim2.new(1,0,1,0); LT.BackgroundTransparency = 1; LT.Text = "PBL"; LT.TextColor3 = T.Gd; LT.TextSize = 13; LT.Font = Enum.Font.GothamBlack; LT.Parent = LB
    
    local Ti = Instance.new("TextLabel"); Ti.Size = UDim2.new(0.5,0,0,22); Ti.Position = UDim2.new(0,62,0,12); Ti.BackgroundTransparency = 1; Ti.Text = "PBL HUB"; Ti.TextColor3 = T.Tx; Ti.TextSize = 17; Ti.Font = Enum.Font.GothamBlack; Ti.TextXAlignment = Enum.TextXAlignment.Left; Ti.Parent = H
    
    local Sub = Instance.new("TextLabel"); Sub.Size = UDim2.new(0.5,0,0,16); Sub.Position = UDim2.new(0,62,0,34); Sub.BackgroundTransparency = 1; Sub.Text = CONFIG.Versao.."  |  Bem-vindo, "..CONFIG.Nome; Sub.TextColor3 = T.TxD; Sub.TextSize = 10; Sub.Font = Enum.Font.Gotham; Sub.TextXAlignment = Enum.TextXAlignment.Left; Sub.Parent = H
    
    local CloseB = Instance.new("TextButton"); CloseB.Size = UDim2.new(0,28,0,28); CloseB.Position = UDim2.new(1,-40,0,16); CloseB.BackgroundColor3 = Color3.fromRGB(220,60,60); CloseB.Text = "×"; CloseB.TextColor3 = T.Tx; CloseB.TextSize = 16; CloseB.Font = Enum.Font.GothamBold; CloseB.BorderSizePixel = 0; CloseB.AutoButtonColor = false; CloseB.Parent = H
    cor(CloseB,8)
    CloseB.MouseEnter:Connect(function() sHover() end)
    CloseB.MouseButton1Click:Connect(function() sClick(); gui:Destroy() end)
    
    local MinB = Instance.new("TextButton"); MinB.Size = UDim2.new(0,28,0,28); MinB.Position = UDim2.new(1,-74,0,16); MinB.BackgroundColor3 = Color3.fromRGB(230,180,60); MinB.Text = "−"; MinB.TextColor3 = Color3.fromRGB(25,25,30); MinB.TextSize = 16; MinB.Font = Enum.Font.GothamBold; MinB.BorderSizePixel = 0; MinB.AutoButtonColor = false; MinB.Parent = H
    cor(MinB,8)
    MinB.MouseEnter:Connect(function() sHover() end)
    
    -- SIDEBAR
    local Sb = Instance.new("Frame"); Sb.Size = UDim2.new(0,100,1,-60); Sb.Position = UDim2.new(0,0,0,60); Sb.BackgroundColor3 = T.Sb; Sb.BackgroundTransparency = 0.5; Sb.BorderSizePixel = 0; Sb.Parent = Main
    local SbL = Instance.new("Frame"); SbL.Size = UDim2.new(0,1,1,0); SbL.Position = UDim2.new(1,-1,0,0); SbL.BackgroundColor3 = T.Cd; SbL.BackgroundTransparency = 0.5; SbL.BorderSizePixel = 0; SbL.Parent = Sb
    local SbList = Instance.new("UIListLayout"); SbList.Padding = UDim.new(0,4); SbList.HorizontalAlignment = Enum.HorizontalAlignment.Center; SbList.Parent = Sb
    local SbPad = Instance.new("UIPadding"); SbPad.PaddingTop = UDim.new(0,15); SbPad.Parent = Sb
    
    local tabsAtivas = {}
    local conteudos = {}
    
    local function criarTab(nome, icone, id)
        local btn = Instance.new("TextButton"); btn.Size = UDim2.new(0,82,0,58); btn.BackgroundColor3 = T.Sb; btn.BackgroundTransparency = 1; btn.Text = ""; btn.BorderSizePixel = 0; btn.AutoButtonColor = false; btn.Parent = Sb; cor(btn,8)
        local iL = Instance.new("TextLabel"); iL.Size = UDim2.new(1,0,0,24); iL.Position = UDim2.new(0,0,0,8); iL.BackgroundTransparency = 1; iL.Text = icone; iL.TextSize = 20; iL.Font = Enum.Font.GothamBold; iL.TextColor3 = T.TxD; iL.Parent = btn
        local nL = Instance.new("TextLabel"); nL.Size = UDim2.new(1,0,0,14); nL.Position = UDim2.new(0,0,0,36); nL.BackgroundTransparency = 1; nL.Text = nome; nL.TextSize = 9; nL.Font = Enum.Font.GothamBold; nL.TextColor3 = T.TxD; nL.Parent = btn
        
        btn.MouseEnter:Connect(function() if tabsAtivas[id] then return end; sHover(); TweenSvc:Create(btn,TweenInfo.new(0.15),{BackgroundTransparency=0.7}):Play() end)
        btn.MouseLeave:Connect(function() if tabsAtivas[id] then return end; TweenSvc:Create(btn,TweenInfo.new(0.15),{BackgroundTransparency=1}):Play() end)
        btn.MouseButton1Click:Connect(function()
            sClick()
            for k,v in pairs(tabsAtivas) do
                local b,i,n = v.btn,v.icone,v.nome
                tabsAtivas[k]=nil
                TweenSvc:Create(b,TweenInfo.new(0.15),{BackgroundTransparency=1}):Play()
                TweenSvc:Create(i,TweenInfo.new(0.15),{TextColor3=T.TxD}):Play()
                TweenSvc:Create(n,TweenInfo.new(0.15),{TextColor3=T.TxD}):Play()
            end
            tabsAtivas[id] = {btn=btn,icone=iL,nome=nL}
            TweenSvc:Create(btn,TweenInfo.new(0.15),{BackgroundTransparency=0}):Play()
            TweenSvc:Create(btn,TweenInfo.new(0.15),{BackgroundColor3=T.SbA}):Play()
            TweenSvc:Create(iL,TweenInfo.new(0.15),{TextColor3=T.Tx}):Play()
            TweenSvc:Create(nL,TweenInfo.new(0.15),{TextColor3=T.Tx}):Play()
            for k,f in pairs(conteudos) do f.Visible = (k==id) end
        end)
        return btn
    end
    
    criarTab("SCRIPTS","📜","scripts")
    criarTab("UTILS","🔧","utils")
    criarTab("COMBAT","⚔","combat")
    criarTab("INFO","ℹ","info")
    
    -- CONTENT
    local C = Instance.new("Frame"); C.Size = UDim2.new(1,-100,1,-60); C.Position = UDim2.new(0,100,0,60); C.BackgroundTransparency = 1; C.Parent = Main
    
    local function criarConteudo(id,titulo,subtitulo)
        local f = Instance.new("Frame"); f.Size = UDim2.new(1,0,1,0); f.BackgroundTransparency = 1; f.Visible = (id=="scripts"); f.Parent = C; conteudos[id] = f
        local iH = Instance.new("Frame"); iH.Size = UDim2.new(1,-30,0,45); iH.Position = UDim2.new(0,15,0,10); iH.BackgroundTransparency = 1; iH.Parent = f
        local hI = Instance.new("TextLabel"); hI.Size = UDim2.new(0,20,0,20); hI.Position = UDim2.new(0,0,0,5); hI.BackgroundTransparency = 1; hI.Text = "☰"; hI.TextSize = 18; hI.Font = Enum.Font.GothamBold; hI.TextColor3 = T.Tx; hI.TextXAlignment = Enum.TextXAlignment.Left; hI.Parent = iH
        local hT = Instance.new("TextLabel"); hT.Size = UDim2.new(1,-30,0,20); hT.Position = UDim2.new(0,28,0,5); hT.BackgroundTransparency = 1; hT.Text = titulo; hT.TextColor3 = T.Tx; hT.TextSize = 15; hT.Font = Enum.Font.GothamBlack; hT.TextXAlignment = Enum.TextXAlignment.Left; hT.Parent = iH
        local hS = Instance.new("TextLabel"); hS.Size = UDim2.new(1,-30,0,14); hS.Position = UDim2.new(0,28,0,26); hS.BackgroundTransparency = 1; hS.Text = subtitulo; hS.TextColor3 = T.TxD; hS.TextSize = 10; hS.Font = Enum.Font.Gotham; hS.TextXAlignment = Enum.TextXAlignment.Left; hS.Parent = iH
        
        local sc = Instance.new("ScrollingFrame"); sc.Size = UDim2.new(1,-20,1,-75); sc.Position = UDim2.new(0,10,0,65); sc.BackgroundTransparency = 1; sc.BorderSizePixel = 0; sc.ScrollBarThickness = 3; sc.ScrollBarImageColor3 = T.Gd; sc.CanvasSize = UDim2.new(0,0,0,0); sc.Parent = f
        local g = Instance.new("UIGridLayout"); g.CellSize = UDim2.new(0,300,0,105); g.CellPadding = UDim2.new(0,8,0,8); g.SortOrder = Enum.SortOrder.LayoutOrder; g.Parent = sc
        g:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() sc.CanvasSize = UDim2.new(0,0,0,g.AbsoluteContentSize.Y+10) end)
        return sc
    end
    
    local scScripts = criarConteudo("scripts","SCRIPT LIST","Selecione um script")
    local scUtils = criarConteudo("utils","UTILIDADES","Ferramentas úteis")
    local scCombat = criarConteudo("combat","COMBATE","Funções de combate")
    local scInfo = criarConteudo("info","INFORMAÇÕES","Sobre o hub")
    
    local function criarCard(parent,nome,sub,icone,corIcone,acao,ordem)
        local Cd = Instance.new("Frame"); Cd.Size = UDim2.new(1,0,0,105); Cd.BackgroundColor3 = T.Cd; Cd.BorderSizePixel = 0; Cd.LayoutOrder = ordem; Cd.Parent = parent
        cor(Cd,10); grd(Cd,T.Cd,T.Cd2,90); local cs = str(Cd,T.Cd,1.5,0.4)
        
        local iC = Instance.new("Frame"); iC.Size = UDim2.new(0,40,0,40); iC.Position = UDim2.new(0,12,0,12); iC.BackgroundColor3 = corIcone; iC.BackgroundTransparency = 0.75; iC.BorderSizePixel = 0; iC.Parent = Cd
        cor(iC,20); str(iC,corIcone,1.5,0.3)
        local iL = Instance.new("TextLabel"); iL.Size = UDim2.new(1,0,1,0); iL.BackgroundTransparency = 1; iL.Text = icone; iL.TextSize = 20; iL.Font = Enum.Font.GothamBold; iL.TextColor3 = corIcone; iL.Parent = iC
        
        local nL = Instance.new("TextLabel"); nL.Size = UDim2.new(1,-70,0,20); nL.Position = UDim2.new(0,60,0,12); nL.BackgroundTransparency = 1; nL.Text = nome; nL.TextColor3 = T.Tx; nL.TextSize = 12; nL.Font = Enum.Font.GothamBlack; nL.TextXAlignment = Enum.TextXAlignment.Left; nL.Parent = Cd
        local sL = Instance.new("TextLabel"); sL.Size = UDim2.new(1,-70,0,14); sL.Position = UDim2.new(0,60,0,34); sL.BackgroundTransparency = 1; sL.Text = sub; sL.TextColor3 = T.TxD; sL.TextSize = 9; sL.Font = Enum.Font.Gotham; sL.TextXAlignment = Enum.TextXAlignment.Left; sL.Parent = Cd
        
        local aB = Instance.new("TextButton"); aB.Size = UDim2.new(1,-24,0,30); aB.Position = UDim2.new(0,12,1,-42); aB.BackgroundColor3 = T.Sb; aB.Text = "EXECUTE"; aB.TextColor3 = T.TxS; aB.TextSize = 11; aB.Font = Enum.Font.GothamBold; aB.BorderSizePixel = 0; aB.AutoButtonColor = false; aB.Parent = Cd
        cor(aB,6); str(aB,T.Cd,1,0.3)
        
        aB.MouseEnter:Connect(function() sHover(); TweenSvc:Create(aB,TweenInfo.new(0.15),{BackgroundColor3=T.CdH}):Play(); TweenSvc:Create(cs,TweenInfo.new(0.15),{Color=corIcone,Transparency=0.1}):Play() end)
        aB.MouseLeave:Connect(function() TweenSvc:Create(aB,TweenInfo.new(0.15),{BackgroundColor3=T.Sb}):Play(); TweenSvc:Create(cs,TweenInfo.new(0.15),{Color=T.Cd,Transparency=0.4}):Play() end)
        aB.MouseButton1Click:Connect(function()
            sClick()
            if acao then local ok = pcall(acao); if not ok then sErr() else sSuc() end end
            TweenSvc:Create(aB,TweenInfo.new(0.1),{BackgroundColor3=corIcone}):Play()
            task.wait(0.2)
            TweenSvc:Create(aB,TweenInfo.new(0.2),{BackgroundColor3=T.Sb}):Play()
        end)
    end
    
