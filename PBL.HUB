    local infL = Instance.new("TextLabel"); infL.Size = UDim2.new(1,-20,1,-20); infL.Position = UDim2.new(0,10,0,10); infL.BackgroundTransparency = 1; infL.Text = "PBL HUB "..CONFIG.Versao.."\n\nDesenvolvido com ❤\n\nUsuário: "..CONFIG.Nome.."\nData: "..os.date("%d/%m/%Y"); infL.TextColor3 = T.TxS; infL.TextSize = 12; infL.Font = Enum.Font.Gotham; infL.TextXAlignment = Enum.TextXAlignment.Left; infL.TextYAlignment = Enum.TextYAlignment.Top; infL.Parent = inf
