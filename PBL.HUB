-- PBL HUB v3.0 - Key: PBL2026
local CoreGui = game:GetService("CoreGui")
local TweenSvc = game:GetService("TweenService")
local SoundSvc = game:GetService("SoundService")
local Players = game:GetService("Players")
local RunSvc = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Stats = game:GetService("Stats")
local Lighting = game:GetService("Lighting")
local Teleport = game:GetService("TeleportService")
local HttpSvc = game:GetService("HttpService")
local VUser = game:GetService("VirtualUser")
local LP = Players.LocalPlayer

local CONFIG = {Key = "PBL2026", Nome = LP.Name, Versao = "v3.0", DiscordLink = "https://discord.gg/x"}

local T = {
    Bg = Color3.fromRGB(28,28,32), Bg2 = Color3.fromRGB(38,38,42),
    Sb = Color3.fromRGB(22,22,26), SbA = Color3.fromRGB(45,45,50),
    Cd = Color3.fromRGB(52,52,58), Cd2 = Color3.fromRGB(38,38,43),
    CdH = Color3.fromRGB(62,62,70), Tx = Color3.fromRGB(245,245,248),
    TxD = Color3.fromRGB(150,150,160), TxS = Color3.fromRGB(190,190,200),
    Gd = Color3.fromRGB(212,175,100), Sc = Color3.fromRGB(80,220,120),
    Er = Color3.fromRGB(255,90,100), Ac = Color3.fromRGB(100,180,255),
    Wr = Color3.fromRGB(255,190,60)
}

local function cor(p,r) local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,r or 10);c.Parent=p;return c end
local function str(p,c,t,tr) local s=Instance.new("UIStroke");s.Color=c;s.Thickness=t or 1;s.Transparency=tr or 0;s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border;s.Parent=p;return s end
local function grd(p,c1,c2,r) local g=Instance.new("UIGradient");g.Color=ColorSequence.new(c1,c2);g.Rotation=r or 90;g.Parent=p;return g end
local function snd(id,v,pi) pcall(function() local s=Instance.new("Sound");s.SoundId=id;s.Volume=v or 0.35;s.PlaybackSpeed=pi or 1;s.Parent=SoundSvc;s:Play();game:GetService("Debris"):AddItem(s,3) end) end
local function sHover() snd("rbxassetid://5810725781",0.22,1.15) end
local function sClick() snd("rbxassetid://6895094670",0.35,1.1) end
local function sToggle() snd("rbxassetid://6895094670",0.4,1.3) end
local function sErr() snd("rbxassetid://9114419659",0.4,0.85) end
local function sSuc() snd("rbxassetid://9125402735",0.4,1) end

for _,n in ipairs({"PBL_Key","PBL_Main","PBL_Notif"}) do local o=CoreGui:FindFirstChild(n);if o then o:Destroy() end end

local function notificar(msg,cor)
    pcall(function()
        local old=CoreGui:FindFirstChild("PBL_Notif");if old then old:Destroy() end
        local g=Instance.new("ScreenGui");g.Name="PBL_Notif";g.Parent=CoreGui;g.IgnoreGuiInset=true;g.DisplayOrder=9999
        local f=Instance.new("Frame");f.Size=UDim2.new(0,320,0,50);f.Position=UDim2.new(0.5,-160,0,25);f.BackgroundColor3=T.Cd;f.BorderSizePixel=0;f.Parent=g
        cor(f,10);str(f,cor,1.5,0.3)
        local b=Instance.new("Frame");b.Size=UDim2.new(0,3,1,0);b.BackgroundColor3=cor;b.BorderSizePixel=0;b.Parent=f;cor(b,10)
        local l=Instance.new("TextLabel");l.Size=UDim2.new(1,-25,1,0);l.Position=UDim2.new(0,18,0,0);l.BackgroundTransparency=1;l.Text=msg;l.TextColor3=T.Tx;l.TextSize=12;l.Font=Enum.Font.GothamMedium;l.TextXAlignment=Enum.TextXAlignment.Left;l.Parent=f
        task.delay(3,function() if g then g:Destroy() end end)
    end)
end

local funcoes = {
    chilli = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua"))() end) end,
    miranda_afk = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/miirandahub/loader/refs/heads/main/mirandaafk.lua"))() end) end,
    miranda_steal = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/miirandahub/loader/refs/heads/main/stealaeggs"))() end) end,
    lennon_farm = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/lennonxscripts/lennonfarm/refs/heads/main/farmv1.lua"))() end) end,
    lennon_steal = function() pcall(function() loadstring(game:HttpGet("https://raw.githubusercontent.com/lennonxscripts/lennonhubv3/refs/heads/main/stealanegg.lua"))() end) end,
    rejoin = function() notificar("Reconectando...",T.Ac); task.wait(0.5); Teleport:Teleport(game.PlaceId,LP) end,
    hop = function() notificar("Procurando servidor...",T.Ac); pcall(function() local s=HttpSvc:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")); for _,sv in ipairs(s.data) do if sv.id~=game.JobId and sv.playing<sv.maxPlayers then Teleport:TeleportToPlaceInstance(game.PlaceId,sv.id,LP); return end end end) end,
    fullbright = function() pcall(function() Lighting.Ambient=Color3.fromRGB(255,255,255);Lighting.Brightness=2 end); notificar("Fullbright ON",T.Sc) end,
    reset = function() pcall(function() LP.Character.Humanoid.Health=0 end); notificar("Resetado",T.Er) end,
    speed = function() pcall(function() LP.Character.Humanoid.WalkSpeed=math.random(45,55) end); notificar("Speed ativado",T.Sc) end,
    noclip = function() pcall(function() for _,p in ipairs(LP.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end end); notificar("Noclip ON",T.Wr) end,
    fly = function() pcall(function() local h=LP.Character.HumanoidRootPart;local b=Instance.new("BodyVelocity");b.MaxForce=Vector3.new(1e5,1e5,1e5);b.Velocity=Vector3.new(0,50,0);b.Parent=h;task.delay(5,function() b:Destroy() end) end); notificar("Voando 5s",T.Ac) end,
    hide = function() for _,p in ipairs(Players:GetPlayers()) do if p~=LP and p.Character then for _,o in ipairs(p.Character:GetDescendants()) do if o:IsA("BasePart") then o.LocalTransparencyModifier=1 end end end end; notificar("Players escondidos",T.Ac) end,
    antiafk = function() pcall(function() LP.Idled:Connect(function() task.wait(math.random(3,8));VUser:CaptureController();VUser:ClickButton2(Vector2.new()) end) end); notificar("Anti-AFK ON",T.Sc) end,
    fpsboost = function() pcall(function() for _,o in ipairs(workspace:GetDescendants()) do if o:IsA("ParticleEmitter") or o:IsA("Trail") then o.Enabled=false end end end); notificar("FPS Boost ON",T.Wr) end,
    ping = function() local p=math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()); notificar("Ping: "..p.."ms", p<100 and T.Sc or T.Wr) end,
    userid = function() pcall(function() if setclipboard then setclipboard(tostring(LP.UserId)) end end); notificar("ID copiado",T.Ac) end,
    antivoid = function() notificar("Anti-Void ON",T.Sc); task.spawn(function() while true do pcall(function() local c=LP.Character;if not c then return end;local h=c:FindFirstChild("HumanoidRootPart");if h and h.Position.Y<-50 then h.CFrame=CFrame.new(0,50,0);notificar("Anti-Void salvou!",T.Wr) end end);task.wait(math.random(2,5)) end end) end,
    social = function() pcall(function() for _,p in ipairs(Players:GetPlayers()) do if p~=LP then LP:RequestFriendship(p) end end end); notificar("Amigos enviados",T.Ac) end,
    fechartudo = function() for _,n in ipairs({"PBL_Notif","PBL_Confirm"}) do local o=CoreGui:FindFirstChild(n);if o then o:Destroy() end end; notificar("Tudo fechado",T.Er) end,
    sobre = function() notificar("PBL HUB "..CONFIG.Versao,T.Ac) end
}

